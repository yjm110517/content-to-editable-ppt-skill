{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "markdown-wireframe-manifest.schema.json",
  "title": "P2 Markdown Wireframe Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "canonicalization_version", "artifact_type", "deck_id", "revision", "approved_outline_sha256", "slide_content_manifest_sha256", "candidate_sha256", "wireframe_path", "wireframe_sha256", "slides", "status"],
  "properties": {
    "schema_version": {"enum": ["1.1", "1.2"]},
    "canonicalization_version": {"const": "p1-rfc8785-nfc-1"},
    "artifact_type": {"const": "markdown_wireframe_manifest"},
    "deck_id": {"type": "string", "minLength": 1},
    "revision": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "approved_outline_sha256": {"$ref": "#/$defs/hash"},
    "slide_content_manifest_sha256": {"$ref": "#/$defs/hash"},
    "candidate_sha256": {"$ref": "#/$defs/hash"},
    "wireframe_path": {"const": "deck-wireframe.md"},
    "wireframe_sha256": {"$ref": "#/$defs/hash"},
    "slides": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/slide"}},
    "status": {"enum": ["ready_for_preview", "accepted"]}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "slide": {
      "type": "object", "additionalProperties": false,
      "required": ["slide_id", "order", "content_refs", "visual_placeholders"],
      "properties": {
        "slide_id": {"type": "string", "minLength": 1},
        "order": {"type": "integer", "minimum": 1, "maximum": 100},
        "content_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "visual_placeholders": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/visual_placeholder"}}
      }
    },
    "visual_placeholder": {
      "type": "object", "additionalProperties": false,
      "required": ["visual_ref", "role", "subtype", "semantic", "semantic_source_refs"],
      "properties": {
        "visual_ref": {"type": "string", "minLength": 1},
        "role": {"enum": ["icon", "image", "chart", "diagram", "illustration"]},
        "subtype": {"oneOf": [{"type": "null"}, {"enum": ["process", "timeline", "cycle", "relationship", "architecture"]}]},
        "semantic": {"type": "string", "minLength": 1},
        "semantic_source_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "placement": {"$ref": "markdown-wireframe-candidate.schema.json#/$defs/placement"},
        "storyboard": {"type": "array", "minItems": 1, "maxItems": 12, "items": {"$ref": "markdown-wireframe-candidate.schema.json#/$defs/storyboard_beat"}},
        "reading_order": {"type": "array", "minItems": 1, "maxItems": 12, "uniqueItems": true, "items": {"type": "string", "pattern": "^B[0-9]{2,}$"}}
      }
    }
  }
}
