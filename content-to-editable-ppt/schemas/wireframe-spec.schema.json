{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wireframe-spec.schema.json",
  "title": "P2 Per-Slide Wireframe Spec",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "canonicalization_version", "artifact_id", "deck_id", "slide_id", "revision", "parent_sha256", "authority", "coordinate_system", "output_ratio", "layout_pattern", "focal_region_id", "regions", "relationships", "created_at_utc"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "canonicalization_version": {"const": "p1-rfc8785-nfc-1"},
    "artifact_id": {"type": "string", "minLength": 1},
    "deck_id": {"type": "string", "minLength": 1},
    "slide_id": {"type": "string", "minLength": 1},
    "revision": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "parent_sha256": {"$ref": "#/$defs/nullable_hash"},
    "authority": {
      "type": "object", "additionalProperties": false,
      "required": ["slide_content_payload_sha256", "layout_constraints_sha256", "page_metadata_sha256", "wireframe_input_sha256"],
      "properties": {
        "slide_content_payload_sha256": {"$ref": "#/$defs/hash"},
        "layout_constraints_sha256": {"$ref": "#/$defs/hash"},
        "page_metadata_sha256": {"$ref": "#/$defs/hash"},
        "wireframe_input_sha256": {"$ref": "#/$defs/hash"}
      }
    },
    "coordinate_system": {"const": "normalized_10000"},
    "output_ratio": {"enum": ["16:9", "4:3"]},
    "layout_pattern": {"enum": ["cover", "section", "single_column", "two_column", "cards", "comparison", "process", "timeline", "matrix", "chart_focus", "image_focus", "diagram", "summary", "custom"]},
    "focal_region_id": {"type": "string", "minLength": 1},
    "regions": {"type": "array", "minItems": 2, "items": {"$ref": "#/$defs/region"}},
    "relationships": {"type": "array", "items": {"$ref": "#/$defs/relationship"}},
    "created_at_utc": {"$ref": "#/$defs/timestamp"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "nullable_hash": {"oneOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]},
    "timestamp": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "bbox": {
      "type": "object", "additionalProperties": false,
      "required": ["x", "y", "w", "h"],
      "properties": {
        "x": {"type": "integer", "minimum": 0, "maximum": 10000},
        "y": {"type": "integer", "minimum": 0, "maximum": 10000},
        "w": {"type": "integer", "minimum": 1, "maximum": 10000},
        "h": {"type": "integer", "minimum": 1, "maximum": 10000}
      }
    },
    "region": {
      "type": "object", "additionalProperties": false,
      "required": ["region_id", "role", "parent_region_id", "bbox", "content_refs", "semantic_source_refs", "hierarchy_level", "emphasis", "z_index", "overlap_group"],
      "properties": {
        "region_id": {"type": "string", "minLength": 1},
        "role": {"enum": ["container", "title", "content", "image", "chart", "diagram", "footer", "decoration"]},
        "parent_region_id": {"oneOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
        "bbox": {"$ref": "#/$defs/bbox"},
        "content_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "semantic_source_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "hierarchy_level": {"type": "integer", "minimum": 1, "maximum": 20},
        "emphasis": {"enum": ["primary", "secondary", "supporting"]},
        "z_index": {"type": "integer", "minimum": -1000, "maximum": 1000},
        "overlap_group": {"oneOf": [{"type": "string", "minLength": 1}, {"type": "null"}]}
      }
    },
    "relationship": {
      "type": "object", "additionalProperties": false,
      "required": ["relationship_id", "kind", "from_region_id", "to_region_id", "direction"],
      "properties": {
        "relationship_id": {"type": "string", "minLength": 1},
        "kind": {"enum": ["flow", "association", "sequence", "overlay"]},
        "from_region_id": {"type": "string", "minLength": 1},
        "to_region_id": {"type": "string", "minLength": 1},
        "direction": {"enum": ["none", "forward", "backward", "bidirectional"]}
      }
    }
  }
}
