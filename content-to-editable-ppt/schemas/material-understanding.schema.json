{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "material-understanding.schema.json",
  "title": "P1 Material Understanding",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "canonicalization_version", "artifact_id", "deck_id", "revision", "parent_sha256", "external_research", "status", "materials", "facts", "warnings", "ignore_authorizations", "created_at_utc"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "canonicalization_version": {"const": "p1-rfc8785-nfc-1"},
    "artifact_id": {"type": "string", "minLength": 1},
    "deck_id": {"type": "string", "minLength": 1},
    "revision": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "parent_sha256": {"oneOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]},
    "external_research": {"enum": ["not_authorized", "authorized"]},
    "status": {"enum": ["ready", "blocked"]},
    "materials": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/material"}},
    "facts": {"type": "array", "items": {"$ref": "#/$defs/fact"}},
    "warnings": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "ignore_authorizations": {"type": "array", "items": {"$ref": "#/$defs/authorization"}},
    "created_at_utc": {"$ref": "#/$defs/timestamp"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "timestamp": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "material": {
      "type": "object", "additionalProperties": false,
      "required": ["material_id", "display_name", "media_type", "read_status", "required_for_task", "blocking", "content_sha256", "reason"],
      "properties": {
        "material_id": {"type": "string", "minLength": 1},
        "display_name": {"type": "string", "minLength": 1},
        "media_type": {"type": "string", "minLength": 1},
        "read_status": {"enum": ["readable", "partially_readable", "unreadable"]},
        "required_for_task": {"type": "boolean"},
        "blocking": {"type": "boolean"},
        "content_sha256": {"oneOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]},
        "reason": {"type": ["string", "null"]}
      }
    },
    "fact": {
      "type": "object", "additionalProperties": false,
      "required": ["fact_id", "text", "kind", "source_refs"],
      "properties": {
        "fact_id": {"type": "string", "minLength": 1},
        "text": {"type": "string", "minLength": 1},
        "kind": {"enum": ["fact", "data", "quotation", "conclusion", "user_instruction", "derived_transition"]},
        "source_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "authorization": {
      "type": "object", "additionalProperties": false,
      "required": ["material_id", "material_record_sha256", "user_message_sha256", "authorized_at_utc"],
      "properties": {
        "material_id": {"type": "string", "minLength": 1},
        "material_record_sha256": {"$ref": "#/$defs/hash"},
        "user_message_sha256": {"$ref": "#/$defs/hash"},
        "authorized_at_utc": {"$ref": "#/$defs/timestamp"}
      }
    }
  }
}
