{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wireframe-manifest.schema.json",
  "title": "P2 Wireframe Deck Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "canonicalization_version", "artifact_id", "deck_id", "revision", "parent_sha256", "output_ratio", "layout_requirements_sha256", "slides", "created_at_utc"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "canonicalization_version": {"const": "p1-rfc8785-nfc-1"},
    "artifact_id": {"type": "string", "minLength": 1},
    "deck_id": {"type": "string", "minLength": 1},
    "revision": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "parent_sha256": {"$ref": "#/$defs/nullable_hash"},
    "output_ratio": {"enum": ["16:9", "4:3"]},
    "layout_requirements_sha256": {"$ref": "#/$defs/hash"},
    "slides": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["slide_id", "order", "spec_path", "spec_sha256", "wireframe_input_sha256", "svg_path", "svg_sha256", "build_status"],
        "properties": {
          "slide_id": {"type": "string", "minLength": 1},
          "order": {"type": "integer", "minimum": 1, "maximum": 100},
          "spec_path": {"type": "string", "minLength": 1},
          "spec_sha256": {"$ref": "#/$defs/hash"},
          "wireframe_input_sha256": {"$ref": "#/$defs/hash"},
          "svg_path": {"oneOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
          "svg_sha256": {"$ref": "#/$defs/nullable_hash"},
          "build_status": {"enum": ["rebuilt", "reused"]}
        }
      }
    },
    "created_at_utc": {"$ref": "#/$defs/timestamp"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "nullable_hash": {"oneOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]},
    "timestamp": {"type": "string", "format": "date-time", "pattern": "Z$"}
  }
}
