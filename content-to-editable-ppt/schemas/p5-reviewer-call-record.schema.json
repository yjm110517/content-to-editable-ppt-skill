{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "p5-reviewer-call-record.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_type", "deck_id", "input_profile", "call_id", "call_manifest_sha256", "evidence_sha256", "raw_response_sha256", "finalized_response_sha256", "role_config_sha256", "prompt_sha256", "response_schema_sha256", "call_ledger_sha256", "context_id", "parent_context_id", "technical_retry_count", "live", "status"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "artifact_type": {"const": "p5_reviewer_call_record"},
    "deck_id": {"type": "string", "minLength": 1},
    "input_profile": {"enum": ["exception_batch", "deck_consistency"]},
    "call_id": {"type": "string", "minLength": 1},
    "call_manifest_sha256": {"$ref": "#/$defs/hash"},
    "evidence_sha256": {"$ref": "#/$defs/hash"},
    "raw_response_sha256": {"$ref": "#/$defs/hash"},
    "finalized_response_sha256": {"$ref": "#/$defs/hash"},
    "role_config_sha256": {"$ref": "#/$defs/hash"},
    "prompt_sha256": {"$ref": "#/$defs/hash"},
    "response_schema_sha256": {"$ref": "#/$defs/hash"},
    "call_ledger_sha256": {"oneOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]},
    "context_id": {"type": "string", "minLength": 1},
    "parent_context_id": {"type": "null"},
    "technical_retry_count": {"type": "integer", "minimum": 0, "maximum": 2},
    "live": {"type": "boolean"},
    "status": {"const": "succeeded"}
  },
  "allOf": [
    {"if": {"properties": {"live": {"const": true}}, "required": ["live"]}, "then": {"properties": {"call_ledger_sha256": {"$ref": "#/$defs/hash"}}}},
    {"if": {"properties": {"live": {"const": false}}, "required": ["live"]}, "then": {"properties": {"call_ledger_sha256": {"type": "null"}}}}
  ],
  "$defs": {"hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
