{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "issue-attribution.schema.json",
  "title": "P0.5 Live Issue Attribution",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "case_id", "reviewer_severity", "classification", "deterministic_evidence", "reasons"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "case_id": {"type": "string", "pattern": "^B0[1-6]$"},
    "reviewer_severity": {"enum": ["none", "suggestion", "minor", "major", "critical"]},
    "classification": {"enum": ["runtime_regression", "agent_variance_candidate", "pre_existing_visual_issue"]},
    "deterministic_evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content_regression", "editability_regression", "topology_regression", "structural_qa_regression", "artifact_regression", "related_runtime_input_changed"],
      "properties": {
        "content_regression": {"type": "boolean"},
        "editability_regression": {"type": "boolean"},
        "topology_regression": {"type": "boolean"},
        "structural_qa_regression": {"type": "boolean"},
        "artifact_regression": {"type": "boolean"},
        "related_runtime_input_changed": {"type": "boolean"}
      }
    },
    "reasons": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  }
}
