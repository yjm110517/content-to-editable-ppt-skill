{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "raster-handoff-pending.schema.json",
  "title": "P3.1 Raster Handoff Pending",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "deck_id",
    "slide_id",
    "visual_ref",
    "semantic",
    "semantic_source_refs",
    "p2_manifest_sha256",
    "visual_direction_sha256",
    "search_evidence_sha256",
    "selection_decision_sha256",
    "reason",
    "status",
    "created_at_utc"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "artifact_type": {"const": "raster_handoff_pending"},
    "deck_id": {"type": "string", "minLength": 1},
    "slide_id": {"type": "string", "minLength": 1},
    "visual_ref": {"type": "string", "minLength": 1},
    "semantic": {"type": "string", "minLength": 1},
    "semantic_source_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "p2_manifest_sha256": {"$ref": "#/$defs/hash"},
    "visual_direction_sha256": {"$ref": "#/$defs/hash"},
    "search_evidence_sha256": {"$ref": "#/$defs/hash"},
    "selection_decision_sha256": {"$ref": "#/$defs/hash"},
    "reason": {"const": "no_accurate_tabler_match"},
    "status": {"const": "raster_handoff_pending"},
    "created_at_utc": {"type": "string", "format": "date-time", "pattern": "Z$"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
