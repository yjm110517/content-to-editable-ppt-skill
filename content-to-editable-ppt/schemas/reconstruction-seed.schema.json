{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "reconstruction-seed.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_type", "deck_id", "slide_id", "element_id", "reconstruction_class", "p4_strategy", "fidelity_priority", "normalized_bbox", "z_index", "relationship_refs", "implementation"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "artifact_type": {"const": "reconstruction_seed"},
    "deck_id": {"type": "string", "minLength": 1},
    "slide_id": {"type": "string", "minLength": 1},
    "element_id": {"type": "string", "minLength": 1},
    "source_ref": {"type": ["string", "null"]},
    "reconstruction_class": {"enum": ["native_shape", "native_text", "native_chart", "sanitized_svg", "reusable_raster", "generated_background", "generated_foreground", "decorative_approximation"]},
    "p4_strategy": {"enum": ["rebuild_from_element_map", "reuse_authority_text_spec", "reuse_powerpoint_chart_spec", "reuse_authority_asset", "extract_from_raw_layer", "reuse_background_raster", "rebuild_background_from_style_tokens", "approximate_from_style_tokens"]},
    "fidelity_priority": {"enum": ["critical", "major", "minor"]},
    "editable_required": {"type": "boolean"},
    "normalized_bbox": {"$ref": "#/$defs/bbox"},
    "z_index": {"type": "integer", "minimum": 0},
    "relationship_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "implementation": {"type": "object", "minProperties": 1},
    "seed_input_sha256": {"$ref": "#/$defs/hash"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "norm": {"type": "integer", "minimum": 0, "maximum": 10000},
    "bbox": {"type": "object", "additionalProperties": false, "required": ["x", "y", "w", "h"], "properties": {"x": {"$ref": "#/$defs/norm"}, "y": {"$ref": "#/$defs/norm"}, "w": {"type": "integer", "minimum": 1, "maximum": 10000}, "h": {"type": "integer", "minimum": 1, "maximum": 10000}}}
  }
}
