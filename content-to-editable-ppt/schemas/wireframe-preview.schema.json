{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wireframe-preview.schema.json",
  "title": "P2 Wireframe Preview Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "canonicalization_version", "artifact_id", "deck_id", "wireframe_manifest_sha256", "mode", "decided_by", "visible_slide_ids", "pause_for_feedback", "decision_reason", "user_message_sha256", "presented_at_utc"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "canonicalization_version": {"const": "p1-rfc8785-nfc-1"},
    "artifact_id": {"type": "string", "minLength": 1},
    "deck_id": {"type": "string", "minLength": 1},
    "wireframe_manifest_sha256": {"$ref": "#/$defs/hash"},
    "mode": {"enum": ["user_visible", "internal_only"]},
    "decided_by": {"enum": ["user", "host"]},
    "visible_slide_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "pause_for_feedback": {"type": "boolean"},
    "decision_reason": {"type": "string", "minLength": 1},
    "user_message_sha256": {"$ref": "#/$defs/nullable_hash"},
    "presented_at_utc": {"oneOf": [{"$ref": "#/$defs/timestamp"}, {"type": "null"}]}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "nullable_hash": {"oneOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]},
    "timestamp": {"type": "string", "format": "date-time", "pattern": "Z$"}
  }
}
