{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "visual-fidelity-report.schema.json", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "artifact_type", "deck_id", "slide_id", "approved_preview_sha256", "candidate_render_sha256", "classification", "metrics", "reviewer_required", "blocking_issues"],
  "properties": {
    "schema_version": {"const": "1.0"}, "artifact_type": {"const": "visual_fidelity_report"}, "deck_id": {"type": "string", "minLength": 1}, "slide_id": {"type": "string", "minLength": 1}, "approved_preview_sha256": {"$ref": "#/$defs/hash"}, "candidate_render_sha256": {"$ref": "#/$defs/hash"},
    "classification": {"enum": ["pass", "reviewer_candidate", "targeted_patch_candidate", "blocking_structural_drift"]},
    "metrics": {"type": "object", "additionalProperties": false, "required": ["rgb_mean_absolute_error_milli", "edge_difference_milli", "region_difference_milli"], "properties": {"rgb_mean_absolute_error_milli": {"type": "integer", "minimum": 0}, "edge_difference_milli": {"type": "integer", "minimum": 0}, "region_difference_milli": {"type": "integer", "minimum": 0}}},
    "reviewer_required": {"type": "boolean"}, "blocking_issues": {"type": "array", "items": {"type": "string", "minLength": 1}}
  }, "$defs": {"hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
