{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "deck-request.schema.json",
  "title": "P1 Deck Request",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "canonicalization_version", "task_id", "deck_id", "topic", "objective", "audience", "language", "page_count", "output_ratio", "source_material_ids", "must_preserve", "prohibited_changes", "visual_requirements", "external_research"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "canonicalization_version": {"const": "p1-rfc8785-nfc-1"},
    "task_id": {"type": "string", "minLength": 1},
    "deck_id": {"type": "string", "minLength": 1},
    "topic": {"type": "string", "minLength": 1},
    "objective": {"type": "string", "minLength": 1},
    "audience": {"type": "string", "minLength": 1},
    "language": {"type": "string", "minLength": 1},
    "page_count": {"type": "integer", "minimum": 1, "maximum": 100},
    "output_ratio": {"enum": ["16:9", "4:3"]},
    "source_material_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "must_preserve": {"$ref": "#/$defs/strings"},
    "prohibited_changes": {"$ref": "#/$defs/strings"},
    "visual_requirements": {"$ref": "#/$defs/strings"},
    "external_research": {"enum": ["not_authorized", "authorized"]}
  },
  "$defs": {
    "strings": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
  }
}
