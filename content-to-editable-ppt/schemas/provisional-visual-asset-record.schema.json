{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"provisional-visual-asset-record.schema.json","type":"object","additionalProperties":false,"required":["schema_version","artifact_type","deck_id","slide_id","element_id","visual_ref","generated_layer_sha256","crop_bbox","asset_path","asset_sha256","background_separation","extraction_quality","status"],"properties":{"schema_version":{"const":"1.0"},"artifact_type":{"const":"provisional_visual_asset_record"},"deck_id":{"type":"string","minLength":1},"slide_id":{"type":"string","minLength":1},"element_id":{"type":"string","minLength":1},"visual_ref":{"type":["string","null"]},"generated_layer_sha256":{"$ref":"#/$defs/hash"},"crop_bbox":{"$ref":"design-element-map.schema.json#/$defs/bbox"},"asset_path":{"type":"string","minLength":1},"asset_sha256":{"$ref":"#/$defs/hash"},"background_separation":{"enum":["transparent","clean_local_background"]},"extraction_quality":{"enum":["pass","fail"]},"status":{"const":"provisional"}},"$defs":{"hash":{"type":"string","pattern":"^[a-f0-9]{64}$"}}}
