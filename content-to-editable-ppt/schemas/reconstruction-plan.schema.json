{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "reconstruction-plan.schema.json",
  "title": "Canonical Reconstruction Plan",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "page", "source", "slide", "elements"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "iteration"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
        "iteration": {"type": "integer", "minimum": 1}
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approved_design"],
      "properties": {
        "approved_design": {"type": "string", "minLength": 1}
      }
    },
    "slide": {
      "type": "object",
      "additionalProperties": false,
      "required": ["width_in", "height_in", "background"],
      "properties": {
        "width_in": {"type": "number", "exclusiveMinimum": 0},
        "height_in": {"type": "number", "exclusiveMinimum": 0},
        "background": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"}
      }
    },
    "elements": {
      "type": "array",
      "minItems": 1,
      "items": {
        "oneOf": [
          {"$ref": "#/$defs/nativeText"},
          {"$ref": "#/$defs/nativeShape"},
          {"$ref": "#/$defs/nativeConnector"},
          {"$ref": "#/$defs/rasterAsset"},
          {"$ref": "#/$defs/knownUnsupported"}
        ]
      }
    }
  },
  "$defs": {
    "color": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}(?:[0-9A-Fa-f]{2})?$"},
    "geometry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["coordinate_space", "x", "y", "width", "height"],
      "properties": {
        "coordinate_space": {"const": "normalized"},
        "x": {"type": "number", "minimum": 0, "exclusiveMaximum": 1},
        "y": {"type": "number", "minimum": 0, "exclusiveMaximum": 1},
        "width": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "height": {"type": "number", "exclusiveMinimum": 0, "maximum": 1}
      }
    },
    "fill": {
      "type": "object",
      "additionalProperties": false,
      "required": ["color"],
      "properties": {
        "color": {"$ref": "#/$defs/color"},
        "transparency": {"type": "number", "minimum": 0, "maximum": 100}
      }
    },
    "line": {
      "type": "object",
      "additionalProperties": false,
      "required": ["color", "width_pt"],
      "properties": {
        "color": {"$ref": "#/$defs/color"},
        "transparency": {"type": "number", "minimum": 0, "maximum": 100},
        "width_pt": {"type": "number", "exclusiveMinimum": 0},
        "dash": {"enum": ["solid", "dash", "dashDot", "lgDash", "lgDashDot", "lgDashDotDot", "sysDash", "sysDot"]},
        "begin_arrow": {"enum": ["none", "arrow", "diamond", "oval", "stealth", "triangle"]},
        "end_arrow": {"enum": ["none", "arrow", "diamond", "oval", "stealth", "triangle"]}
      }
    },
    "shadow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["color", "opacity", "blur_pt", "angle", "offset_pt"],
      "properties": {
        "color": {"type": "string", "pattern": "^#[0-9A-Fa-f]{6}$"},
        "opacity": {"type": "number", "minimum": 0, "maximum": 1},
        "blur_pt": {"type": "number", "minimum": 0},
        "angle": {"type": "number", "minimum": 0, "maximum": 359.999},
        "offset_pt": {"type": "number", "minimum": 0}
      }
    },
    "base": {
      "type": "object",
      "required": ["id", "role", "representation", "geometry", "z_index"],
      "properties": {
        "id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
        "role": {"type": "string", "minLength": 1},
        "representation": {"enum": ["native_text", "native_shape", "native_connector", "raster_asset", "native_chart", "native_table", "svg"]},
        "geometry": {"$ref": "#/$defs/geometry"},
        "z_index": {"type": "integer"}
      }
    },
    "textStyle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["font_face", "font_size_pt", "color"],
      "properties": {
        "font_face": {"type": "string", "minLength": 1},
        "font_size_pt": {"type": "number", "exclusiveMinimum": 0},
        "bold": {"type": "boolean"},
        "italic": {"type": "boolean"},
        "underline": {"type": "boolean"},
        "color": {"$ref": "#/$defs/color"},
        "transparency": {"type": "number", "minimum": 0, "maximum": 100},
        "align": {"enum": ["left", "center", "right", "justify"]},
        "valign": {"enum": ["top", "middle", "bottom"]},
        "margin_in": {"oneOf": [{"type": "number", "minimum": 0}, {"type": "array", "minItems": 4, "maxItems": 4, "items": {"type": "number", "minimum": 0}}]},
        "fit": {"enum": ["none", "shrink", "resize-shape"]},
        "language": {"type": "string", "minLength": 2}
      }
    },
    "shapeStyle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["shape"],
      "properties": {
        "shape": {"enum": ["rect", "roundRect", "ellipse", "triangle", "rtTriangle", "diamond", "hexagon", "chevron", "pentagon", "star5"]},
        "fill": {"$ref": "#/$defs/fill"},
        "line": {"$ref": "#/$defs/line"},
        "shadow": {"$ref": "#/$defs/shadow"},
        "radius_hint": {"type": "number", "minimum": 0}
      },
      "anyOf": [{"required": ["fill"]}, {"required": ["line"]}]
    },
    "connectorStyle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["line"],
      "properties": {"line": {"$ref": "#/$defs/line"}}
    },
    "nativeText": {
      "allOf": [
        {"$ref": "#/$defs/base"},
        {"type": "object", "required": ["content_ref", "style"], "properties": {"representation": {"const": "native_text"}, "content_ref": {"type": "string", "minLength": 1}, "style": {"$ref": "#/$defs/textStyle"}}}
      ],
      "unevaluatedProperties": false
    },
    "nativeShape": {
      "allOf": [
        {"$ref": "#/$defs/base"},
        {"type": "object", "required": ["style"], "properties": {"representation": {"const": "native_shape"}, "style": {"$ref": "#/$defs/shapeStyle"}}}
      ],
      "unevaluatedProperties": false
    },
    "nativeConnector": {
      "allOf": [
        {"$ref": "#/$defs/base"},
        {"type": "object", "required": ["from_id", "to_id", "style"], "properties": {"representation": {"const": "native_connector"}, "from_id": {"type": "string", "minLength": 1}, "to_id": {"type": "string", "minLength": 1}, "style": {"$ref": "#/$defs/connectorStyle"}}}
      ],
      "unevaluatedProperties": false
    },
    "assetRequest": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source", "source_region", "contains_text"],
      "properties": {
        "source": {"const": "approved_design"},
        "source_region": {"$ref": "#/$defs/geometry"},
        "contains_text": {"const": false}
      }
    },
    "rasterAsset": {
      "allOf": [
        {"$ref": "#/$defs/base"},
        {"type": "object", "required": ["asset_request"], "properties": {"representation": {"const": "raster_asset"}, "asset_request": {"$ref": "#/$defs/assetRequest"}}}
      ],
      "unevaluatedProperties": false
    },
    "knownUnsupported": {
      "allOf": [
        {"$ref": "#/$defs/base"},
        {"type": "object", "properties": {"representation": {"enum": ["native_chart", "native_table", "svg"]}}}
      ],
      "unevaluatedProperties": false
    }
  }
}
