{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "exception-review-evidence.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "deck_id",
    "batch_slide_ids",
    "bound_issue_ids",
    "budget",
    "ledger_entry"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "artifact_type": {
      "const": "exception_review_evidence"
    },
    "deck_id": {
      "type": "string",
      "minLength": 1
    },
    "batch_slide_ids": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "bound_issue_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^P5-[A-Z0-9]{12}$"
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "batch_size",
        "batch_calls"
      ],
      "properties": {
        "batch_size": {
          "const": 4
        },
        "batch_calls": {
          "const": 2
        }
      }
    },
    "batches": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "batch_index",
          "slide_ids",
          "bound_issue_ids"
        ],
        "properties": {
          "batch_index": {
            "type": "integer",
            "minimum": 1
          },
          "slide_ids": {
            "type": "array",
            "maxItems": 4,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "bound_issue_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^P5-[A-Z0-9]{12}$"
            }
          }
        }
      }
    },
    "ledger_entry": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "role": {
          "const": "reviewer"
        },
        "call_id": {
          "type": "string",
          "minLength": 1
        },
        "live": {
          "type": "boolean"
        },
        "bound_issue_ids": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
