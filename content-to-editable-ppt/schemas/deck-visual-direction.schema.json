{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "deck-visual-direction.schema.json",
  "title": "P3.0 Deck Visual Direction",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_type", "deck_id", "p2_manifest_sha256", "icon_family", "created_at_utc"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "artifact_type": {"const": "deck_visual_direction"},
    "deck_id": {"type": "string", "minLength": 1},
    "p2_manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "icon_family": {"const": "tabler-outline"},
    "created_at_utc": {"type": "string", "format": "date-time", "pattern": "Z$"}
  }
}
