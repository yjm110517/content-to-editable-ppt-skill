{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"generated-visual-layer-record.schema.json","type":"object","additionalProperties":false,"required":["schema_version","artifact_type","deck_id","slide_id","revision","prompt_sha256","runtime_lock_sha256","source_image_sha256","source_width_px","source_height_px","image_path","image_sha256","width_px","height_px","normalization","generation_kind","technical_retry_count","status"],"properties":{"schema_version":{"const":"1.0"},"artifact_type":{"const":"generated_visual_layer_record"},"deck_id":{"type":"string","minLength":1},"slide_id":{"type":"string","minLength":1},"revision":{"type":"integer","minimum":1},"prompt_sha256":{"$ref":"#/$defs/hash"},"runtime_lock_sha256":{"$ref":"#/$defs/hash"},"source_image_sha256":{"$ref":"#/$defs/hash"},"source_width_px":{"type":"integer","minimum":1},"source_height_px":{"type":"integer","minimum":1},"image_path":{"type":"string","minLength":1},"image_sha256":{"$ref":"#/$defs/hash"},"width_px":{"enum":[1200,1600]},"height_px":{"const":900},"normalization":{"enum":["none","lanczos_resize"]},"generation_kind":{"enum":["initial","user_revision"]},"technical_retry_count":{"type":"integer","minimum":0,"maximum":2},"status":{"const":"consumed"}},"$defs":{"hash":{"type":"string","pattern":"^[a-f0-9]{64}$"}}}
