{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "candidate-outline.schema.json",
  "title": "P1 Candidate Outline",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "canonicalization_version", "artifact_id", "deck_id", "revision", "parent_sha256", "material_understanding_sha256", "host_pass_counts", "pages", "created_at_utc"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "canonicalization_version": {"const": "p1-rfc8785-nfc-1"},
    "artifact_id": {"type": "string", "minLength": 1},
    "deck_id": {"type": "string", "minLength": 1},
    "revision": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "parent_sha256": {"oneOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]},
    "material_understanding_sha256": {"$ref": "#/$defs/hash"},
    "user_revision_request_sha256": {"$ref": "#/$defs/hash"},
    "host_pass_counts": {
      "type": "object", "additionalProperties": false,
      "required": ["planning", "revision", "automatic_regeneration"],
      "properties": {
        "planning": {"const": 1},
        "revision": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "automatic_regeneration": {"const": 0}
      }
    },
    "pages": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/page"}},
    "created_at_utc": {"$ref": "#/$defs/timestamp"}
  },
  "allOf": [
    {"if": {"properties": {"revision": {"minimum": 2}}, "required": ["revision"]}, "then": {"required": ["user_revision_request_sha256"]}}
  ],
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "timestamp": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "text": {
      "type": "object", "additionalProperties": false,
      "required": ["content_ref", "text"],
      "properties": {"content_ref": {"type": "string", "minLength": 1}, "text": {"type": "string", "minLength": 1}}
    },
    "block": {
      "type": "object", "additionalProperties": false,
      "required": ["content_ref", "order", "text", "source_refs"],
      "properties": {
        "content_ref": {"type": "string", "minLength": 1},
        "order": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "text": {"type": "string", "minLength": 1},
        "source_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "page": {
      "type": "object", "additionalProperties": false,
      "required": ["slide_id", "order", "role", "purpose", "key_message", "title", "content_blocks", "visual_intent", "source_refs"],
      "properties": {
        "slide_id": {"type": "string", "minLength": 1},
        "order": {"type": "integer", "minimum": 1, "maximum": 100},
        "role": {"type": "string", "minLength": 1},
        "purpose": {"type": "string", "minLength": 1},
        "key_message": {"type": "string", "minLength": 1},
        "title": {"$ref": "#/$defs/text"},
        "content_blocks": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/block"}},
        "visual_intent": {"type": "string", "minLength": 1},
        "source_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    }
  }
}
