{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "approved-slide-content.schema.json",
  "title": "P1 Approved Slide Content",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "canonicalization_version", "artifact_id", "deck_id", "slide_id", "order", "revision", "parent_sha256", "approved_outline_revision", "approved_outline_sha256", "confirmation_id", "projection", "title", "content_blocks", "status", "frozen_at_utc"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "canonicalization_version": {"const": "p1-rfc8785-nfc-1"},
    "artifact_id": {"type": "string", "minLength": 1},
    "deck_id": {"type": "string", "minLength": 1},
    "slide_id": {"type": "string", "minLength": 1},
    "order": {"type": "integer", "minimum": 1, "maximum": 100},
    "revision": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "parent_sha256": {"oneOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]},
    "approved_outline_revision": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "approved_outline_sha256": {"$ref": "#/$defs/hash"},
    "confirmation_id": {"type": "string", "minLength": 1},
    "projection": {
      "type": "object", "additionalProperties": false,
      "required": ["tool_version", "input_sha256", "output_content_sha256"],
      "properties": {
        "tool_version": {"const": "1.0"},
        "input_sha256": {"$ref": "#/$defs/hash"},
        "output_content_sha256": {"$ref": "#/$defs/hash"}
      }
    },
    "title": {"$ref": "candidate-outline.schema.json#/$defs/text"},
    "content_blocks": {"type": "array", "minItems": 1, "items": {"$ref": "candidate-outline.schema.json#/$defs/block"}},
    "status": {"const": "frozen"},
    "frozen_at_utc": {"$ref": "#/$defs/timestamp"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "timestamp": {"type": "string", "format": "date-time", "pattern": "Z$"}
  }
}
