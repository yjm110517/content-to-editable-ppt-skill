{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"image-generation-call-record.schema.json","type":"object","additionalProperties":false,"required":["schema_version","artifact_type","call_id","deck_id","slide_id","revision","prompt_sha256","runtime_lock_sha256","generation_kind","technical_retry_count","status"],"properties":{"schema_version":{"const":"1.0"},"artifact_type":{"const":"image_generation_call_record"},"call_id":{"type":"string","minLength":1},"deck_id":{"type":"string","minLength":1},"slide_id":{"type":"string","minLength":1},"revision":{"type":"integer","minimum":1},"prompt_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"runtime_lock_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"generation_kind":{"enum":["initial","user_revision"]},"technical_retry_count":{"type":"integer","minimum":0,"maximum":2},"status":{"const":"succeeded"}}}
