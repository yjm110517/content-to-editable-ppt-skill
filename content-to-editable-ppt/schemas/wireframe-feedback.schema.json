{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wireframe-feedback.schema.json",
  "title": "P2 Wireframe User Feedback",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "canonicalization_version", "feedback_id", "deck_id", "wireframe_manifest_sha256", "decision", "affected_slide_ids", "user_message_sha256", "created_at_utc"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "canonicalization_version": {"const": "p1-rfc8785-nfc-1"},
    "feedback_id": {"type": "string", "minLength": 1},
    "deck_id": {"type": "string", "minLength": 1},
    "wireframe_manifest_sha256": {"$ref": "#/$defs/hash"},
    "decision": {"enum": ["accepted", "continue", "changes_requested"]},
    "affected_slide_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "user_message_sha256": {"$ref": "#/$defs/hash"},
    "created_at_utc": {"$ref": "#/$defs/timestamp"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "timestamp": {"type": "string", "format": "date-time", "pattern": "Z$"}
  }
}
