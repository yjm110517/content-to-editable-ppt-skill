{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "reviewer-technical-failure.schema.json",
  "title": "Reviewer Technical Failure Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "iteration", "call_id", "category", "code", "attempts", "normalized_message", "planner_calls", "timestamp_utc"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "task_id": {"type": "string", "minLength": 1},
    "iteration": {"type": "integer", "minimum": 1},
    "call_id": {"type": "string", "minLength": 1},
    "category": {"const": "technical_failure"},
    "code": {"enum": ["reviewer_timeout", "reviewer_unavailable", "reviewer_technical_failure"]},
    "attempts": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["attempt", "code", "normalized_message", "timeout_seconds", "exit_code", "attempted_at_utc"],
        "properties": {
          "attempt": {"type": "integer", "minimum": 0, "maximum": 2},
          "code": {"type": "string", "minLength": 1},
          "normalized_message": {"type": "string", "minLength": 1},
          "timeout_seconds": {"type": ["number", "null"], "exclusiveMinimum": 0},
          "exit_code": {"type": ["integer", "null"]},
          "attempted_at_utc": {"type": "string", "format": "date-time", "pattern": "Z$"}
        }
      }
    },
    "normalized_message": {"type": "string", "minLength": 1},
    "planner_calls": {"const": 0},
    "timestamp_utc": {"type": "string", "format": "date-time", "pattern": "Z$"}
  }
}
