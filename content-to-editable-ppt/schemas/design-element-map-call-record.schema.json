{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "design-element-map-call-record.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_type", "call_id", "deck_id", "slide_id", "map_input_manifest_sha256", "generated_layer_sha256", "prompt_package_sha256", "raw_response_sha256", "finalized_element_map_sha256", "model_selection_mode", "requested_model", "context_id", "parent_context_id", "technical_retry_count", "map_correction_count", "status", "prepared_at_utc", "invoked_at_utc", "completed_at_utc"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "artifact_type": {"const": "design_element_map_call_record"},
    "call_id": {"type": "string", "minLength": 1},
    "deck_id": {"type": "string", "minLength": 1},
    "slide_id": {"type": "string", "minLength": 1},
    "map_input_manifest_sha256": {"$ref": "#/$defs/hash"},
    "generated_layer_sha256": {"$ref": "#/$defs/hash"},
    "prompt_package_sha256": {"$ref": "#/$defs/hash"},
    "raw_response_sha256": {"$ref": "#/$defs/hash"},
    "finalized_element_map_sha256": {"$ref": "#/$defs/hash"},
    "model_selection_mode": {"enum": ["runtime-default", "explicit"]},
    "requested_model": {"type": ["string", "null"]},
    "context_id": {"type": "string", "minLength": 1},
    "parent_context_id": {"type": "null"},
    "technical_retry_count": {"type": "integer", "minimum": 0, "maximum": 2},
    "map_correction_count": {"type": "integer", "minimum": 0, "maximum": 1},
    "status": {"const": "succeeded"},
    "prepared_at_utc": {"$ref": "#/$defs/time"},
    "invoked_at_utc": {"$ref": "#/$defs/time"},
    "completed_at_utc": {"$ref": "#/$defs/time"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "time": {"type": "string", "format": "date-time", "pattern": "Z$"}
  }
}
