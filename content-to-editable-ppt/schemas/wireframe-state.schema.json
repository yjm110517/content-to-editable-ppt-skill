{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wireframe-state.schema.json",
  "title": "P2 Wireframe State",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "canonicalization_version", "task_id", "deck_id", "state", "active_pass_id", "budgets", "counters", "current_artifacts", "page_results", "history"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "canonicalization_version": {"const": "p1-rfc8785-nfc-1"},
    "task_id": {"type": "string", "minLength": 1},
    "deck_id": {"type": "string", "minLength": 1},
    "state": {"$ref": "#/$defs/state"},
    "active_pass_id": {"oneOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
    "budgets": {
      "type": "object", "additionalProperties": false,
      "required": ["max_contract_corrections_per_pass", "max_host_invocations_per_pass", "absolute_host_model_invocation_ceiling"],
      "properties": {
        "max_contract_corrections_per_pass": {"const": 2},
        "max_host_invocations_per_pass": {"const": 3},
        "absolute_host_model_invocation_ceiling": {"oneOf": [{"type": "integer", "minimum": 1}, {"type": "null"}]}
      }
    },
    "counters": {
      "type": "object", "additionalProperties": false,
      "required": ["host_wireframe_initial_pass_count", "host_wireframe_revision_pass_count", "host_wireframe_contract_correction_count", "host_model_invocation_count", "current_pass_contract_corrections", "current_pass_host_invocations", "automatic_wireframe_redesign_count", "layout_planner_calls", "reviewer_calls", "image_generation_calls"],
      "properties": {
        "host_wireframe_initial_pass_count": {"type": "integer", "minimum": 0, "maximum": 1},
        "host_wireframe_revision_pass_count": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "host_wireframe_contract_correction_count": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "host_model_invocation_count": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "current_pass_contract_corrections": {"type": "integer", "minimum": 0, "maximum": 2},
        "current_pass_host_invocations": {"type": "integer", "minimum": 0, "maximum": 3},
        "automatic_wireframe_redesign_count": {"const": 0},
        "layout_planner_calls": {"const": 0},
        "reviewer_calls": {"const": 0},
        "image_generation_calls": {"const": 0}
      }
    },
    "current_artifacts": {
      "type": "object", "additionalProperties": false,
      "required": ["layout_requirements_sha256", "approved_outline_sha256", "slide_content_manifest_sha256", "candidate_manifest_sha256", "wireframe_manifest_sha256", "preview_sha256"],
      "properties": {
        "layout_requirements_sha256": {"$ref": "#/$defs/nullable_hash"},
        "approved_outline_sha256": {"$ref": "#/$defs/nullable_hash"},
        "slide_content_manifest_sha256": {"$ref": "#/$defs/nullable_hash"},
        "candidate_manifest_sha256": {"$ref": "#/$defs/nullable_hash"},
        "wireframe_manifest_sha256": {"$ref": "#/$defs/nullable_hash"},
        "preview_sha256": {"$ref": "#/$defs/nullable_hash"}
      }
    },
    "page_results": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["slide_id", "wireframe_input_sha256", "build_status", "spec_sha256", "svg_sha256"],
        "properties": {
          "slide_id": {"type": "string", "minLength": 1},
          "wireframe_input_sha256": {"$ref": "#/$defs/hash"},
          "build_status": {"enum": ["rebuilt", "reused", "invalidated"]},
          "spec_sha256": {"$ref": "#/$defs/nullable_hash"},
          "svg_sha256": {"$ref": "#/$defs/nullable_hash"}
        }
      }
    },
    "history": {"type": "array", "items": {"$ref": "#/$defs/history"}}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "nullable_hash": {"oneOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]},
    "timestamp": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "state": {"enum": ["received", "validating_inputs", "p2_bypassed", "inputs_validated", "wireframe_planning", "candidate_specs_ready", "validating_specs", "contract_correction_required", "applying_contract_correction", "specs_accepted", "rendering", "rendered", "preview_recorded", "awaiting_wireframe_feedback", "revision_requested", "p2_complete", "wireframe_failed"]},
    "history": {
      "type": "object", "additionalProperties": false,
      "required": ["from", "to", "event", "artifact_kind", "artifact_sha256", "user_evidence_sha256", "host_model_invocation_id", "timestamp_utc"],
      "properties": {
        "from": {"$ref": "#/$defs/state"},
        "to": {"$ref": "#/$defs/state"},
        "event": {"type": "string", "minLength": 1},
        "artifact_kind": {"type": ["string", "null"]},
        "artifact_sha256": {"$ref": "#/$defs/nullable_hash"},
        "user_evidence_sha256": {"$ref": "#/$defs/nullable_hash"},
        "host_model_invocation_id": {"type": ["string", "null"]},
        "timestamp_utc": {"$ref": "#/$defs/timestamp"}
      }
    }
  }
}
