{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "p5-final-render-manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "deck_id",
    "renderer",
    "renderer_version",
    "width_px",
    "height_px",
    "ppt_sha256",
    "slides",
    "p4_inheritance",
    "status"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "artifact_type": {
      "const": "p5_final_render_manifest"
    },
    "deck_id": {
      "type": "string",
      "minLength": 1
    },
    "renderer": {
      "type": "string",
      "minLength": 1
    },
    "renderer_version": {
      "type": "string",
      "minLength": 1
    },
    "width_px": {
      "type": "integer",
      "minimum": 1
    },
    "height_px": {
      "type": "integer",
      "minimum": 1
    },
    "ppt_sha256": {
      "$ref": "#/$defs/hash"
    },
    "slides": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "order",
          "path",
          "png_sha256",
          "decoded_rgb_sha256",
          "p4_decoded_rgb_sha256"
        ],
        "properties": {
          "order": {
            "type": "integer",
            "minimum": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "png_sha256": {
            "$ref": "#/$defs/hash"
          },
          "decoded_rgb_sha256": {
            "$ref": "#/$defs/hash"
          },
          "p4_decoded_rgb_sha256": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "p4_inheritance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "p4_candidate_render_report_sha256",
        "p4_post_assembly_report_sha256",
        "p4_fidelity_inherited"
      ],
      "properties": {
        "p4_candidate_render_report_sha256": {
          "$ref": "#/$defs/hash"
        },
        "p4_post_assembly_report_sha256": {
          "$ref": "#/$defs/hash"
        },
        "p4_fidelity_inherited": {
          "const": true
        }
      }
    },
    "status": {
      "enum": [
        "pass",
        "fail"
      ]
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
