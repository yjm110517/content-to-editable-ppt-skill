{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "planner-response.schema.json",
  "title": "Layout Planner Response",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "iteration", "mode"],
  "properties": {
    "schema_version": {"enum": ["1.4", "1.5"]},
    "task_id": {"type": "string", "minLength": 1},
    "iteration": {"type": "integer", "minimum": 1},
    "mode": {"enum": ["initial", "revision"]},
    "outcome": {"enum": ["plan", "patch", "block"]},
    "artifacts": {"type": "object"},
    "block": {"$ref": "#/$defs/block"}
  },
  "$defs": {
    "block": {
      "type": "object",
      "additionalProperties": false,
      "required": ["code", "scope", "message"],
      "properties": {
        "code": {"enum": ["grounding_incomplete", "authority_conflict", "missing_structured_data", "unsafe_crop", "unsupported_reconstruction", "revision_scope_exceeded", "revision_requires_replan"]},
        "scope": {"enum": ["objects", "page"]},
        "object_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "message": {"type": "string", "minLength": 1}
      },
      "allOf": [
        {"if": {"properties": {"scope": {"const": "objects"}}, "required": ["scope"]}, "then": {"required": ["object_ids"]}},
        {"if": {"properties": {"scope": {"const": "page"}}, "required": ["scope"]}, "then": {"not": {"required": ["object_ids"]}}}
      ]
    }
  },
  "allOf": [
    {
      "if": {"properties": {"mode": {"const": "initial"}}, "required": ["mode"]},
      "then": {
        "oneOf": [
          {
            "required": ["outcome", "artifacts"],
            "properties": {
              "outcome": {"const": "plan"},
              "artifacts": {"type": "object", "additionalProperties": false, "required": ["reconstruction_plan"], "properties": {"reconstruction_plan": {"type": "object"}}}
            },
            "not": {"required": ["block"]}
          },
          {
            "required": ["outcome", "block"],
            "properties": {"outcome": {"const": "block"}},
            "not": {"required": ["artifacts"]}
          }
        ]
      }
    },
    {
      "if": {"properties": {"mode": {"const": "revision"}}, "required": ["mode"]},
      "then": {
        "oneOf": [
          {
            "required": ["outcome", "artifacts"],
            "properties": {"schema_version": {"const": "1.5"}, "outcome": {"const": "patch"}, "artifacts": {"type": "object", "additionalProperties": false, "required": ["revision_patch"], "properties": {"revision_patch": {"type": "object"}}}},
            "not": {"required": ["block"]}
          },
          {
            "required": ["outcome", "block"],
            "properties": {"schema_version": {"const": "1.5"}, "outcome": {"const": "block"}},
            "not": {"required": ["artifacts"]}
          },
          {
            "properties": {"schema_version": {"const": "1.4"}, "artifacts": {"type": "object", "additionalProperties": false, "required": ["review_patch"], "properties": {"review_patch": {"type": "object"}}}},
            "required": ["artifacts"],
            "not": {"anyOf": [{"required": ["outcome"]}, {"required": ["block"]}]}
          }
        ]
      }
    }
  ]
}
