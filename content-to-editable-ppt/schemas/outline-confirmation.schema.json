{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "outline-confirmation.schema.json",
  "title": "P1 Outline Confirmation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "canonicalization_version", "confirmation_id", "deck_id", "candidate_revision", "candidate_sha256", "status", "user_message_sha256", "created_at_utc"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "canonicalization_version": {"const": "p1-rfc8785-nfc-1"},
    "confirmation_id": {"type": "string", "minLength": 1},
    "deck_id": {"type": "string", "minLength": 1},
    "candidate_revision": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "candidate_sha256": {"$ref": "#/$defs/hash"},
    "status": {"enum": ["confirmed", "changes_requested", "rejected"]},
    "user_message_sha256": {"$ref": "#/$defs/hash"},
    "created_at_utc": {"$ref": "#/$defs/timestamp"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "timestamp": {"type": "string", "format": "date-time", "pattern": "Z$"}
  }
}
