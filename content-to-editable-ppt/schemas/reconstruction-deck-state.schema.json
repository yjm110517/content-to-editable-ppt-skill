{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "reconstruction-deck-state.schema.json", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "artifact_type", "deck_id", "state", "budgets", "counters", "page_states", "current_artifacts", "history"],
  "properties": {
    "schema_version": {"const": "1.0"}, "artifact_type": {"const": "reconstruction_deck_state"}, "deck_id": {"type": "string", "minLength": 1},
    "state": {"enum": ["p3_3_complete", "reconstruction_preflight", "asset_manifest_ready", "smoke_set_selected", "smoke_reconstructing", "smoke_failed", "smoke_passed", "reconstructing_pages", "pages_reconstructed", "building_candidate_deck", "rendering_candidate_deck", "post_assembly_comparison", "p4_complete", "p4_failed"]},
    "budgets": {"type": "object", "additionalProperties": false, "required": ["smoke_page_limit", "targeted_patch_per_page", "technical_retry_per_stage", "reviewer_per_exception"], "properties": {"smoke_page_limit": {"const": 2}, "targeted_patch_per_page": {"const": 2}, "technical_retry_per_stage": {"const": 2}, "reviewer_per_exception": {"const": 1}}},
    "counters": {"type": "object", "additionalProperties": false, "required": ["initial_planner_calls", "targeted_patch_planner_calls", "reviewer_calls", "image_generation_calls"], "properties": {"initial_planner_calls": {"const": 0}, "targeted_patch_planner_calls": {"type": "integer", "minimum": 0}, "reviewer_calls": {"type": "integer", "minimum": 0}, "image_generation_calls": {"const": 0}}},
    "page_states": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["slide_id", "state_sha256"], "properties": {"slide_id": {"type": "string", "minLength": 1}, "state_sha256": {"$ref": "#/$defs/hash"}}}},
    "current_artifacts": {"type": "object"}, "history": {"type": "array", "items": {"type": "object"}}
  }, "$defs": {"hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
