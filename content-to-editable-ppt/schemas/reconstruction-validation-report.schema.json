{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "reconstruction-validation-report.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_type", "deck_id", "slide_id", "spec_sha256", "status", "issues"],
  "properties": {
    "schema_version": {"const": "1.0"}, "artifact_type": {"const": "reconstruction_validation_report"},
    "deck_id": {"type": "string", "minLength": 1}, "slide_id": {"type": "string", "minLength": 1},
    "spec_sha256": {"$ref": "#/$defs/hash"}, "status": {"enum": ["pass", "targeted_patch_required", "blocking"]},
    "issues": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["validation_issue_id", "code", "path", "message", "classification"], "properties": {"validation_issue_id": {"type": "string", "minLength": 1}, "code": {"type": "string", "minLength": 1}, "path": {"type": "string", "minLength": 1}, "message": {"type": "string", "minLength": 1}, "classification": {"enum": ["correctable", "blocking", "reviewer_candidate"]}}}}
  }, "$defs": {"hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
