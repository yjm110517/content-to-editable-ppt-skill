{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "run-state.schema.json",
  "title": "Content to Editable PPT Run State",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "task_id", "request_sha256", "state", "current_iteration", "max_iterations", "history"],
  "properties": {
    "schema_version": {"enum": ["1.3", "1.4"]},
    "task_id": {"type": "string", "minLength": 1},
    "request_sha256": {"$ref": "#/$defs/hash"},
    "state": {"$ref": "#/$defs/state"},
    "current_iteration": {"type": "integer", "minimum": 0},
    "max_iterations": {"type": "integer", "minimum": 1},
    "current_stage": {"type": ["string", "null"]},
    "counters": {
      "type": "object",
      "additionalProperties": false,
      "required": ["planner_calls", "reviewer_calls", "full_semantic_replans", "targeted_revisions", "technical_retries", "runtime_repairs"],
      "properties": {
        "planner_calls": {"type": "integer", "minimum": 0},
        "reviewer_calls": {"type": "integer", "minimum": 0},
        "full_semantic_replans": {"type": "integer", "minimum": 0, "maximum": 1},
        "targeted_revisions": {"type": "integer", "minimum": 0, "maximum": 2},
        "technical_retries": {"type": "integer", "minimum": 0},
        "runtime_repairs": {"type": "integer", "minimum": 0, "maximum": 1}
      }
    },
    "stages": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/stage"}
    },
    "last_failure": {"oneOf": [{"$ref": "runtime-error.schema.json"}, {"type": "null"}]},
    "reclassifications": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to", "evidence", "timestamp_utc"],
        "properties": {
          "from": {"const": "local_spec_failure"},
          "to": {"const": "global_semantic_failure"},
          "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "timestamp_utc": {"$ref": "#/$defs/timestamp"}
        }
      }
    },
    "review_degradation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["reviewer_failure_sha256", "warning", "gates", "completed_at_utc"],
      "properties": {
        "reviewer_failure_sha256": {"$ref": "#/$defs/hash"},
        "warning": {"const": "visual review incomplete"},
        "gates": {
          "type": "object",
          "additionalProperties": false,
          "required": ["structural", "content", "editability"],
          "properties": {
            "structural": {"const": true},
            "content": {"const": true},
            "editability": {"const": true}
          }
        },
        "completed_at_utc": {"$ref": "#/$defs/timestamp"}
      }
    },
    "history": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to", "reason", "artifact", "artifact_sha256", "timestamp_utc"],
        "properties": {
          "from": {"$ref": "#/$defs/state"},
          "to": {"$ref": "#/$defs/state"},
          "reason": {"type": "string", "minLength": 1},
          "artifact": {"type": ["string", "null"]},
          "artifact_sha256": {"oneOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]},
          "timestamp_utc": {"$ref": "#/$defs/timestamp"}
        }
      }
    },
    "pending_decision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["iteration", "review_evaluation_sha256", "warnings"],
      "properties": {
        "iteration": {"type": "integer", "minimum": 1},
        "review_evaluation_sha256": {"$ref": "#/$defs/hash"},
        "warnings": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    },
    "acceptance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["outcome", "actor_type", "actor_id", "message_sha256", "decision_at_utc", "warning_candidate_sha256"],
      "properties": {
        "outcome": {"enum": ["accepted", "rejected"]},
        "actor_type": {"enum": ["user", "acceptance_role"]},
        "actor_id": {"type": ["string", "null"]},
        "message_sha256": {"$ref": "#/$defs/hash"},
        "decision_at_utc": {"$ref": "#/$defs/timestamp"},
        "warning_candidate_sha256": {"$ref": "#/$defs/hash"}
      }
    },
    "delivery": {
      "type": "object",
      "additionalProperties": false,
      "required": ["accepted_iteration", "delivery_decision_sha256", "output_name", "files"],
      "properties": {
        "accepted_iteration": {"type": "integer", "minimum": 1},
        "delivery_decision_sha256": {"$ref": "#/$defs/hash"},
        "output_name": {"type": "string", "minLength": 1},
        "files": {"type": "object", "minProperties": 7, "maxProperties": 7, "additionalProperties": {"$ref": "#/$defs/hash"}}
      }
    }
  },
  "allOf": [
    {
      "if": {"properties": {"schema_version": {"const": "1.4"}}, "required": ["schema_version"]},
      "then": {"required": ["current_stage", "counters", "stages", "last_failure", "reclassifications"]}
    },
    {
      "if": {"properties": {"state": {"const": "input_pending"}}, "required": ["state"]},
      "then": {"properties": {"current_iteration": {"const": 0}}},
      "else": {"properties": {"current_iteration": {"minimum": 1}}}
    },
    {
      "if": {"properties": {"state": {"const": "awaiting_user_acceptance"}}, "required": ["state"]},
      "then": {"required": ["pending_decision"]}
    },
    {
      "if": {"required": ["acceptance"]},
      "then": {"required": ["pending_decision"]}
    },
    {
      "if": {"properties": {"state": {"const": "delivered"}}, "required": ["state"]},
      "then": {"required": ["delivery"]}
    },
    {
      "if": {"properties": {"state": {"const": "delivered_with_warnings"}}, "required": ["state"]},
      "then": {"required": ["review_degradation"]}
    }
  ],
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "timestamp": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "state": {"enum": ["input_pending", "planning", "spec_ready", "building", "structural_fail", "structural_pass", "reviewing", "review_evaluating", "review_revise", "review_pass", "review_fail", "review_warning_candidate", "awaiting_user_acceptance", "packaging", "delivered", "delivered_with_warnings", "failed"]},
    "stage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "input_sha256", "outputs", "attempt_count", "completed_at_utc"],
      "properties": {
        "status": {"enum": ["pending", "running", "passed", "failed", "skipped", "reused"]},
        "input_sha256": {"$ref": "#/$defs/hash"},
        "outputs": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["path", "sha256"],
            "properties": {"path": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/hash"}}
          }
        },
        "attempt_count": {"type": "integer", "minimum": 0, "maximum": 3},
        "completed_at_utc": {"oneOf": [{"$ref": "#/$defs/timestamp"}, {"type": "null"}]}
      }
    }
  }
}
