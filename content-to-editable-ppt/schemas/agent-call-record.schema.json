{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "agent-call-record.schema.json",
  "title": "Agent Call Record",
  "oneOf": [{"$ref": "#/$defs/record_1_3"}, {"$ref": "#/$defs/record_1_4"}],
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "requested_model": {"oneOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
    "configured_parameters": {
      "type": "object", "additionalProperties": false,
      "required": ["temperature", "top_p", "seed"],
      "properties": {
        "temperature": {"type": "number", "minimum": 0, "maximum": 2},
        "top_p": {"type": "number", "exclusiveMinimum": 0, "maximum": 1},
        "seed": {"type": ["integer", "null"]}
      }
    },
    "number_observation": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["status", "value", "source"],
         "properties": {"status": {"const": "observed"}, "value": {"type": "number"}, "source": {"const": "host_runtime_metadata"}}},
        {"type": "object", "additionalProperties": false, "required": ["status", "reason"],
         "properties": {"status": {"const": "unavailable"}, "reason": {"const": "host_not_exposed"}}}
      ]
    },
    "seed_observation": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["status", "value", "source"],
         "properties": {"status": {"const": "observed"}, "value": {"type": ["integer", "null"]}, "source": {"const": "host_runtime_metadata"}}},
        {"type": "object", "additionalProperties": false, "required": ["status", "reason"],
         "properties": {"status": {"const": "unavailable"}, "reason": {"const": "host_not_exposed"}}}
      ]
    },
    "record_1_3": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "task_id", "iteration", "role", "role_version", "model_selection_mode", "requested_model", "config_sha256", "prompt_sha256", "output_schema_sha256", "input_sha256", "parameters", "call_id", "context_id", "parent_context_id", "status"],
      "properties": {
        "schema_version": {"const": "1.3"}, "task_id": {"type": "string", "minLength": 1},
        "iteration": {"type": "integer", "minimum": 1}, "role": {"enum": ["planner", "reviewer"]},
        "role_version": {"type": "string", "pattern": "^1\\.[0-9]+\\.[0-9]+$"},
        "model_selection_mode": {"enum": ["runtime-default", "explicit", "allowlist"]},
        "requested_model": {"$ref": "#/$defs/requested_model"}, "config_sha256": {"$ref": "#/$defs/hash"},
        "prompt_sha256": {"$ref": "#/$defs/hash"}, "output_schema_sha256": {"$ref": "#/$defs/hash"},
        "input_sha256": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/hash"}},
        "parameters": {"$ref": "#/$defs/configured_parameters"}, "call_id": {"type": "string", "minLength": 1},
        "context_id": {"type": "string", "minLength": 1}, "parent_context_id": {"type": "null"},
        "status": {"enum": ["succeeded", "failed"]},
        "resolved_model_identity": {"oneOf": [{"$ref": "reviewer-model-identity.schema.json"}, {"type": "null"}]},
        "resolved_model_identity_sha256": {"oneOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]},
        "transport_request_sha256": {"oneOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]},
        "prepared_at_utc": {"type": ["string", "null"]}, "invoked_at_utc": {"type": ["string", "null"]},
        "completed_at_utc": {"type": ["string", "null"]}
      }
    },
    "record_1_4": {
      "type": "object", "additionalProperties": false,
      "required": ["schema_version", "task_id", "iteration", "role", "role_version", "model_selection_mode", "requested_model", "config_sha256", "prompt_sha256", "output_schema_sha256", "input_sha256", "configured_parameters", "parameter_observations", "call_id", "context_id", "parent_context_id", "status", "context_evidence", "delivered_inputs", "raw_response_sha256"],
      "properties": {
        "schema_version": {"const": "1.4"}, "task_id": {"type": "string", "minLength": 1},
        "iteration": {"type": "integer", "minimum": 1}, "role": {"enum": ["planner", "reviewer"]},
        "role_version": {"type": "string", "pattern": "^1\\.[0-9]+\\.[0-9]+$"},
        "model_selection_mode": {"enum": ["runtime-default", "explicit", "allowlist"]},
        "requested_model": {"$ref": "#/$defs/requested_model"}, "config_sha256": {"$ref": "#/$defs/hash"},
        "prompt_sha256": {"$ref": "#/$defs/hash"}, "output_schema_sha256": {"$ref": "#/$defs/hash"},
        "input_sha256": {"type": "object", "minProperties": 1, "additionalProperties": {"$ref": "#/$defs/hash"}},
        "configured_parameters": {"$ref": "#/$defs/configured_parameters"},
        "parameter_observations": {
          "type": "object", "additionalProperties": false, "required": ["temperature", "top_p", "seed"],
          "properties": {"temperature": {"$ref": "#/$defs/number_observation"}, "top_p": {"$ref": "#/$defs/number_observation"}, "seed": {"$ref": "#/$defs/seed_observation"}}
        },
        "call_id": {"type": "string", "minLength": 1}, "context_id": {"type": "string", "minLength": 1},
        "parent_context_id": {"type": "null"}, "status": {"enum": ["succeeded", "failed"]},
        "context_evidence": {
          "type": "object", "additionalProperties": false,
          "required": ["status", "method", "context_id", "parent_context_id"],
          "properties": {"status": {"const": "observed"}, "method": {"enum": ["new_host_context", "history_free_context"]},
                         "context_id": {"type": "string", "minLength": 1}, "parent_context_id": {"type": "null"}}
        },
        "delivered_inputs": {
          "type": "array", "minItems": 1,
          "items": {"type": "object", "additionalProperties": false, "required": ["name", "sha256", "media_type", "modality"],
                    "properties": {"name": {"type": "string", "minLength": 1}, "sha256": {"$ref": "#/$defs/hash"},
                                   "media_type": {"type": "string", "minLength": 1}, "modality": {"enum": ["document", "image"]}}}
        },
        "raw_response_sha256": {"$ref": "#/$defs/hash"},
        "resolved_model_identity": {"oneOf": [{"$ref": "reviewer-model-identity.schema.json"}, {"type": "null"}]},
        "resolved_model_identity_sha256": {"oneOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]},
        "transport_request_sha256": {"oneOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]},
        "prepared_at_utc": {"type": ["string", "null"]}, "invoked_at_utc": {"type": ["string", "null"]},
        "completed_at_utc": {"type": ["string", "null"]}
      }
    }
  }
}
