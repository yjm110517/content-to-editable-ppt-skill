{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "visual-reconstruction-spec.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_type", "deck_id", "slide_id", "order", "order_sensitive", "order_bindings", "approved_preview_sha256", "element_map_sha256", "reconstruction_seed_view_sha256", "content_authority_sha256", "asset_manifest_sha256", "page_input_sha256", "elements", "status"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "artifact_type": {"const": "visual_reconstruction_spec"},
    "deck_id": {"type": "string", "minLength": 1},
    "slide_id": {"type": "string", "minLength": 1},
    "order": {"type": "integer", "minimum": 1},
    "order_sensitive": {"type": "boolean"},
    "order_bindings": {"type": "array", "uniqueItems": true, "items": {"enum": ["slide_ordinal", "section_ordinal", "progress_fraction", "total_slide_count", "previous_slide_id", "next_slide_id"]}},
    "approved_preview_sha256": {"$ref": "#/$defs/hash"},
    "element_map_sha256": {"$ref": "#/$defs/hash"},
    "reconstruction_seed_view_sha256": {"$ref": "#/$defs/hash"},
    "content_authority_sha256": {"$ref": "#/$defs/hash"},
    "asset_manifest_sha256": {"$ref": "#/$defs/hash"},
    "page_input_sha256": {"$ref": "#/$defs/hash"},
    "elements": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["element_id", "source_ref", "reconstruction_class", "p4_strategy", "fidelity_priority", "normalized_bbox", "z_index", "implementation"], "properties": {"element_id": {"type": "string", "minLength": 1}, "source_ref": {"type": ["string", "null"]}, "reconstruction_class": {"enum": ["native_shape", "native_text", "native_chart", "sanitized_svg", "reusable_raster", "generated_background", "generated_foreground", "decorative_approximation"]}, "p4_strategy": {"type": "string", "minLength": 1}, "fidelity_priority": {"enum": ["critical", "major", "minor"]}, "normalized_bbox": {"$ref": "#/$defs/bbox"}, "z_index": {"type": "integer", "minimum": 0}, "implementation": {"type": "object", "minProperties": 1}}}},
    "status": {"const": "validated"}
  },
  "$defs": {"hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "norm": {"type": "integer", "minimum": 0, "maximum": 10000}, "bbox": {"type": "object", "additionalProperties": false, "required": ["x", "y", "w", "h"], "properties": {"x": {"$ref": "#/$defs/norm"}, "y": {"$ref": "#/$defs/norm"}, "w": {"type": "integer", "minimum": 1, "maximum": 10000}, "h": {"type": "integer", "minimum": 1, "maximum": 10000}}}}
}
