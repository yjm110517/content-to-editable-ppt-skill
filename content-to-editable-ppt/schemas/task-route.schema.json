{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "task-route.schema.json",
  "title": "P1 Task Route",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "canonicalization_version", "task_id", "route_id", "revision", "parent_route_sha256", "route", "intent_summary", "evidence", "created_at_utc"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "canonicalization_version": {"const": "p1-rfc8785-nfc-1"},
    "task_id": {"type": "string", "minLength": 1},
    "route_id": {"type": "string", "minLength": 1},
    "revision": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "parent_route_sha256": {"oneOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]},
    "route": {"enum": ["content_to_ppt", "image_to_editable_ppt", "needs_clarification"]},
    "intent_summary": {"type": "string", "minLength": 1},
    "evidence": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "created_at_utc": {"$ref": "#/$defs/timestamp"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "timestamp": {"type": "string", "format": "date-time", "pattern": "Z$"}
  }
}
