{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wireframe-validation-report.schema.json",
  "title": "P2 Wireframe Validation Report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "canonicalization_version", "report_id", "deck_id", "candidate_manifest_sha256", "status", "issues", "validated_at_utc"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "canonicalization_version": {"const": "p1-rfc8785-nfc-1"},
    "report_id": {"type": "string", "minLength": 1},
    "deck_id": {"type": "string", "minLength": 1},
    "candidate_manifest_sha256": {"$ref": "#/$defs/hash"},
    "status": {"enum": ["pass", "correctable", "blocking"]},
    "issues": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["issue_id", "slide_id", "classification", "code", "path", "message", "correctable"],
        "properties": {
          "issue_id": {"type": "string", "minLength": 1},
          "slide_id": {"oneOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
          "classification": {"enum": ["correctable_contract_error", "blocking_authority_error", "redesign_required", "preview_warning"]},
          "code": {"type": "string", "minLength": 1},
          "path": {"type": "string", "minLength": 1},
          "message": {"type": "string", "minLength": 1},
          "correctable": {"type": "boolean"}
        }
      }
    },
    "validated_at_utc": {"$ref": "#/$defs/timestamp"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "timestamp": {"type": "string", "format": "date-time", "pattern": "Z$"}
  }
}
