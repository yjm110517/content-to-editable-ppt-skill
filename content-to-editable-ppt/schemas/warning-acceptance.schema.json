{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "warning-acceptance.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "deck_id",
    "decision",
    "qa_report_sha256",
    "deck_consistency_report_sha256",
    "policy_sha256",
    "user_message_sha256",
    "accepted_at_utc",
    "reason_code"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "artifact_type": { "const": "warning_acceptance" },
    "deck_id": { "type": "string", "minLength": 1 },
    "decision": { "enum": ["accept", "reject"] },
    "qa_report_sha256": { "$ref": "#/$defs/hash" },
    "deck_consistency_report_sha256": { "$ref": "#/$defs/hash" },
    "policy_sha256": { "$ref": "#/$defs/hash" },
    "user_message_sha256": { "$ref": "#/$defs/hash" },
    "accepted_at_utc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$" },
    "reason_code": { "type": "string", "minLength": 1 }
  },
  "$defs": { "hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" } }
}
