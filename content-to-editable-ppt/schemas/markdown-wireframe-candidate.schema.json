{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "markdown-wireframe-candidate.schema.json",
  "title": "P2 Markdown Wireframe Host Candidate",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "canonicalization_version", "artifact_type", "artifact_id", "deck_id", "revision", "parent_sha256", "pass_id", "host_model_invocation_id", "slides", "created_at_utc"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "canonicalization_version": {"const": "p1-rfc8785-nfc-1"},
    "artifact_type": {"const": "markdown_wireframe_candidate"},
    "artifact_id": {"type": "string", "minLength": 1},
    "deck_id": {"type": "string", "minLength": 1},
    "revision": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "parent_sha256": {"oneOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]},
    "pass_id": {"type": "string", "minLength": 1},
    "host_model_invocation_id": {"type": "string", "minLength": 1},
    "slides": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/slide"}},
    "created_at_utc": {"$ref": "#/$defs/timestamp"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "timestamp": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "label": {
      "type": "object", "additionalProperties": false,
      "required": ["content_ref", "label"],
      "properties": {
        "content_ref": {"type": "string", "minLength": 1},
        "label": {"type": "string", "minLength": 1, "maxLength": 200}
      }
    },
    "slide": {
      "type": "object", "additionalProperties": false,
      "required": ["slide_id", "order", "layout_draft", "content_labels", "layout_notes"],
      "properties": {
        "slide_id": {"type": "string", "minLength": 1},
        "order": {"type": "integer", "minimum": 1, "maximum": 100},
        "layout_draft": {"type": "string", "minLength": 1, "maxLength": 20000},
        "content_labels": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/label"}},
        "layout_notes": {"type": "string", "minLength": 1, "maxLength": 10000}
      }
    }
  }
}
