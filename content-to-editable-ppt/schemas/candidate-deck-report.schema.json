{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "candidate-deck-report.schema.json", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "artifact_type", "deck_id", "reconstruction_manifest_sha256", "candidate_pptx_path", "candidate_pptx_sha256", "slide_count", "slide_order", "delivery_forbidden", "status"],
  "properties": {"schema_version": {"const": "1.0"}, "artifact_type": {"const": "candidate_deck_report"}, "deck_id": {"type": "string", "minLength": 1}, "reconstruction_manifest_sha256": {"$ref": "#/$defs/hash"}, "candidate_pptx_path": {"type": "string", "minLength": 1}, "candidate_pptx_sha256": {"$ref": "#/$defs/hash"}, "slide_count": {"type": "integer", "minimum": 1}, "slide_order": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "delivery_forbidden": {"const": true}, "status": {"const": "built"}},
  "$defs": {"hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
