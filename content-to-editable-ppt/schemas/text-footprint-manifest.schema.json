{
  "$schema":"https://json-schema.org/draft/2020-12/schema","$id":"text-footprint-manifest.schema.json","title":"P3.2 Text Footprint Manifest","type":"object","additionalProperties":false,
  "required":["schema_version","artifact_type","deck_id","deck_visual_system_sha256","slide_content_manifest_sha256","algorithm","font_environment_sha256","entries","status"],
  "properties":{"schema_version":{"const":"1.0"},"artifact_type":{"const":"text_footprint_manifest"},"deck_id":{"type":"string","minLength":1},"deck_visual_system_sha256":{"$ref":"#/$defs/hash"},"slide_content_manifest_sha256":{"$ref":"#/$defs/hash"},"algorithm":{"const":"pillow-10.4-96dpi-v1"},"font_environment_sha256":{"$ref":"#/$defs/hash"},"entries":{"type":"array","minItems":1,"items":{"$ref":"#/$defs/entry"}},"status":{"const":"pass"}},
  "$defs":{"hash":{"type":"string","pattern":"^[a-f0-9]{64}$"},"norm":{"type":"integer","minimum":0,"maximum":10000},"entry":{"type":"object","additionalProperties":false,"required":["slide_id","content_ref","role","text_sha256","font_token","font_family","font_file_sha256","font_size_pt","line_height_milli","estimated_lines","max_lines","preferred_width","min_height","safe_padding"],"properties":{"slide_id":{"type":"string","minLength":1},"content_ref":{"type":"string","minLength":1},"role":{"enum":["title","subtitle","body","label"]},"text_sha256":{"$ref":"#/$defs/hash"},"font_token":{"enum":["title","subtitle","body","label"]},"font_family":{"type":"string","minLength":1},"font_file_sha256":{"$ref":"#/$defs/hash"},"font_size_pt":{"type":"integer","minimum":8,"maximum":72},"line_height_milli":{"type":"integer","minimum":1000,"maximum":2000},"estimated_lines":{"type":"integer","minimum":1,"maximum":8},"max_lines":{"type":"integer","minimum":1,"maximum":8},"preferred_width":{"$ref":"#/$defs/norm"},"min_height":{"$ref":"#/$defs/norm"},"safe_padding":{"$ref":"#/$defs/norm"}}}}
}
