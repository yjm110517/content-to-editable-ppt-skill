{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "simple-icon-drawing.schema.json",
  "title": "P3.1 Bounded Programmatic Icon Drawing",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_type", "visual_ref", "width", "height", "primitives"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "artifact_type": {"const": "simple_icon_drawing"},
    "visual_ref": {"type": "string", "minLength": 1},
    "width": {"const": 24},
    "height": {"const": 24},
    "primitives": {"type": "array", "minItems": 1, "maxItems": 12, "items": {"$ref": "#/$defs/primitive"}}
  },
  "$defs": {
    "coordinate": {"type": "integer", "minimum": 0, "maximum": 24},
    "point": {
      "type": "object", "additionalProperties": false, "required": ["x", "y"],
      "properties": {"x": {"$ref": "#/$defs/coordinate"}, "y": {"$ref": "#/$defs/coordinate"}}
    },
    "primitive": {
      "oneOf": [
        {"type": "object", "additionalProperties": false, "required": ["type", "x1", "y1", "x2", "y2"], "properties": {"type": {"enum": ["line", "arrow"]}, "x1": {"$ref": "#/$defs/coordinate"}, "y1": {"$ref": "#/$defs/coordinate"}, "x2": {"$ref": "#/$defs/coordinate"}, "y2": {"$ref": "#/$defs/coordinate"}}},
        {"type": "object", "additionalProperties": false, "required": ["type", "x", "y", "width", "height"], "properties": {"type": {"const": "rect"}, "x": {"$ref": "#/$defs/coordinate"}, "y": {"$ref": "#/$defs/coordinate"}, "width": {"type": "integer", "minimum": 1, "maximum": 24}, "height": {"type": "integer", "minimum": 1, "maximum": 24}, "rx": {"type": "integer", "minimum": 0, "maximum": 12}}},
        {"type": "object", "additionalProperties": false, "required": ["type", "cx", "cy", "r"], "properties": {"type": {"const": "circle"}, "cx": {"$ref": "#/$defs/coordinate"}, "cy": {"$ref": "#/$defs/coordinate"}, "r": {"type": "integer", "minimum": 1, "maximum": 12}}},
        {"type": "object", "additionalProperties": false, "required": ["type", "cx", "cy", "rx", "ry"], "properties": {"type": {"const": "ellipse"}, "cx": {"$ref": "#/$defs/coordinate"}, "cy": {"$ref": "#/$defs/coordinate"}, "rx": {"type": "integer", "minimum": 1, "maximum": 12}, "ry": {"type": "integer", "minimum": 1, "maximum": 12}}},
        {"type": "object", "additionalProperties": false, "required": ["type", "points"], "properties": {"type": {"const": "polyline"}, "points": {"type": "array", "minItems": 2, "maxItems": 12, "items": {"$ref": "#/$defs/point"}}}},
        {"type": "object", "additionalProperties": false, "required": ["type", "children"], "properties": {"type": {"const": "group"}, "children": {"type": "array", "minItems": 1, "maxItems": 12, "items": {"$ref": "#/$defs/primitive"}}}}
      ]
    }
  }
}
