{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "reconstruction-patch.schema.json", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "artifact_type", "deck_id", "slide_id", "base_spec_sha256", "patch_iteration", "operations"],
  "properties": {
    "schema_version": {"const": "1.0"}, "artifact_type": {"const": "reconstruction_patch"}, "deck_id": {"type": "string", "minLength": 1}, "slide_id": {"type": "string", "minLength": 1},
    "base_spec_sha256": {"$ref": "#/$defs/hash"}, "patch_iteration": {"type": "integer", "minimum": 1, "maximum": 2},
    "operations": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["validation_issue_id", "op", "path", "before", "after"], "properties": {"validation_issue_id": {"type": "string", "minLength": 1}, "op": {"enum": ["replace"]}, "path": {"type": "string", "pattern": "^/elements/[0-9]+/"}, "before": {}, "after": {}}}}
  }, "$defs": {"hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
