{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "icon-search-evidence.schema.json",
  "title": "P3.1 Offline Icon Search Evidence",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_type", "visual_ref", "p2_manifest_sha256", "query", "normalized_query", "status", "automatic_icon_name", "top_k"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "artifact_type": {"const": "icon_search_evidence"},
    "visual_ref": {"type": "string", "minLength": 1},
    "p2_manifest_sha256": {"$ref": "#/$defs/hash"},
    "query": {"type": "string", "minLength": 1},
    "normalized_query": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "status": {"enum": ["auto_selected", "host_selection_required"]},
    "automatic_icon_name": {"type": ["string", "null"], "minLength": 1},
    "top_k": {
      "type": "array", "minItems": 1, "maxItems": 50,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["name", "aliases", "relative_path", "source_sha256", "score", "evidence"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "aliases": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
          "relative_path": {"type": "string", "pattern": "^icons/outline/[a-z0-9-]+\\.svg$"},
          "source_sha256": {"$ref": "#/$defs/hash"},
          "score": {"type": "integer", "minimum": 0},
          "evidence": {
            "type": "object", "additionalProperties": false,
            "required": ["exact_canonical", "exact_official_alias", "token_overlap", "prefix", "substring", "fuzzy"],
            "properties": {
              "exact_canonical": {"type": "boolean"},
              "exact_official_alias": {"type": "boolean"},
              "token_overlap": {"type": "integer", "minimum": 0},
              "prefix": {"type": "boolean"},
              "substring": {"type": "boolean"},
              "fuzzy": {"type": "integer", "minimum": 0, "maximum": 100}
            }
          }
        }
      }
    }
  },
  "$defs": {"hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
