{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "delivery-packaging-runtime-lock.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "packager",
    "python_version",
    "zlib_version",
    "zlib_runtime_version",
    "compression",
    "compresslevel",
    "entry_timestamp",
    "entry_permissions",
    "entry_order",
    "filename_encoding",
    "platform",
    "create_system",
    "flag_bits_policy",
    "extra_policy",
    "comment",
    "archive_comment",
    "allow_zip64",
    "directory_entry_policy"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "artifact_type": {
      "const": "delivery_packaging_runtime_lock"
    },
    "deck_id": {
      "type": "string",
      "minLength": 1
    },
    "packager": {
      "const": "python.zipfile"
    },
    "python_version": {
      "type": "string",
      "minLength": 1
    },
    "zlib_version": {
      "type": "string",
      "minLength": 1
    },
    "zlib_runtime_version": {
      "type": "string",
      "minLength": 1
    },
    "compression": {
      "const": "deflate"
    },
    "compresslevel": {
      "const": 9
    },
    "entry_timestamp": {
      "const": "1980-01-01T00:00:00Z"
    },
    "entry_permissions": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "file",
        "directory"
      ],
      "properties": {
        "file": {
          "const": "0o644"
        },
        "directory": {
          "const": "0o755"
        }
      }
    },
    "entry_order": {
      "const": "lexical"
    },
    "filename_encoding": {
      "const": "utf-8"
    },
    "platform": {
      "type": "string",
      "minLength": 1
    },
    "create_system": {
      "type": "integer",
      "minimum": 0,
      "maximum": 255
    },
    "flag_bits_policy": {
      "type": "string",
      "minLength": 1
    },
    "extra_policy": {
      "const": "empty"
    },
    "comment": {
      "const": ""
    },
    "archive_comment": {
      "const": ""
    },
    "allow_zip64": {
      "type": "boolean"
    },
    "directory_entry_policy": {
      "type": "string",
      "minLength": 1
    }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
