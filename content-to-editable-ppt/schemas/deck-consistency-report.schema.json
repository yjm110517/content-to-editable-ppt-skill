{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "deck-consistency-report.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "deck_id",
    "reviewer_recommendation",
    "issues",
    "mandatory_checks",
    "structured_upstream_revision",
    "evidence",
    "call_record",
    "does_not_satisfy_adr_040"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "artifact_type": {
      "const": "deck_consistency_report"
    },
    "deck_id": {
      "type": "string",
      "minLength": 1
    },
    "reviewer_recommendation": {
      "enum": [
        "pass",
        "revise",
        "fail"
      ]
    },
    "issues": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "issue_id",
          "severity",
          "dimension",
          "slide_ids",
          "message"
        ],
        "properties": {
          "issue_id": {
            "type": "string",
            "pattern": "^P5-[A-Z0-9]{12}$"
          },
          "severity": {
            "enum": [
              "critical",
              "major",
              "minor",
              "suggestion"
            ]
          },
          "dimension": {
            "type": "string",
            "enum": [
              "typography",
              "palette",
              "background",
              "card_language",
              "density_spacing",
              "visual_treatment",
              "navigation",
              "section_hierarchy",
              "deck_identity",
              "systemic_anomaly"
            ]
          },
          "slide_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "message": {
            "type": "string",
            "minLength": 1
          },
          "finding_scope": {"const": "cross_slide_systemic"},
          "cross_slide_basis": {
            "type": "object",
            "additionalProperties": false,
            "required": ["consistency_rule", "compared_slide_ids", "comparison_summary", "page_level_fidelity_reopened"],
            "properties": {
              "consistency_rule": {"type": "string", "minLength": 1},
              "compared_slide_ids": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
              "comparison_summary": {"type": "string", "minLength": 1},
              "page_level_fidelity_reopened": {"const": false}
            }
          },
          "delivery_impact": {
            "type": "object",
            "additionalProperties": false,
            "required": ["artifact_change_required", "systemic_inconsistency", "accessibility_blocker"],
            "properties": {
              "artifact_change_required": {"type": "boolean"},
              "systemic_inconsistency": {"type": "boolean"},
              "accessibility_blocker": {"type": "boolean"}
            }
          }
        }
      }
    },
    "mandatory_checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "typography_consistent",
        "palette_consistent",
        "background_consistent",
        "card_language_consistent",
        "density_spacing_consistent",
        "visual_treatment_consistent",
        "navigation_consistent",
        "section_hierarchy_consistent",
        "same_deck_identity",
        "no_reopened_p4_fidelity"
      ],
      "properties": {
        "typography_consistent": {
          "type": "boolean"
        },
        "palette_consistent": {
          "type": "boolean"
        },
        "background_consistent": {
          "type": "boolean"
        },
        "card_language_consistent": {
          "type": "boolean"
        },
        "density_spacing_consistent": {
          "type": "boolean"
        },
        "visual_treatment_consistent": {
          "type": "boolean"
        },
        "navigation_consistent": {
          "type": "boolean"
        },
        "section_hierarchy_consistent": {
          "type": "boolean"
        },
        "same_deck_identity": {
          "type": "boolean"
        },
        "no_reopened_p4_fidelity": {
          "const": true
        }
      }
    },
    "structured_upstream_revision": {
      "type": [
        "array",
        "null"
      ],
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "responsible_stage",
          "issue_ids",
          "affected_slide_ids",
          "reason_code",
          "required_revision_scope"
        ],
        "properties": {
          "responsible_stage": {
            "type": "string",
            "enum": [
              "p1",
              "p3_2",
              "p3_3",
              "p4",
              "p5"
            ]
          },
          "issue_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "affected_slide_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "reason_code": {
            "type": "string",
            "minLength": 1
          },
          "required_revision_scope": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "contact_sheets_sha256",
        "exception_review_hashes"
      ],
      "properties": {
        "contact_sheets_sha256": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/hash"
          }
        },
        "exception_review_hashes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/hash"
          }
        }
      }
    },
    "call_record": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": [
        "evidence_sha256",
        "raw_response_sha256",
        "finalized_response_sha256",
        "role_config_sha256",
        "prompt_sha256",
        "response_schema_sha256",
        "resolved_model_identity_sha256",
        "transport_request_sha256",
        "context_id",
        "technical_retry_count"
      ],
      "properties": {
        "evidence_sha256": { "$ref": "#/$defs/hash" },
        "raw_response_sha256": { "$ref": "#/$defs/hash" },
        "finalized_response_sha256": { "$ref": "#/$defs/hash" },
        "role_config_sha256": { "$ref": "#/$defs/hash" },
        "prompt_sha256": { "$ref": "#/$defs/hash" },
        "response_schema_sha256": { "$ref": "#/$defs/hash" },
        "resolved_model_identity_sha256": { "$ref": "#/$defs/hash" },
        "transport_request_sha256": { "$ref": "#/$defs/hash" },
        "context_id": { "type": "string", "minLength": 1 },
        "technical_retry_count": { "type": "integer", "minimum": 0 }
      }
    },
    "does_not_satisfy_adr_040": { "type": "boolean" }
  },
  "$defs": {
    "hash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  }
}
