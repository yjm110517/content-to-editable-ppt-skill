{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wireframe-correction-record.schema.json",
  "title": "P2 Wireframe Contract Correction Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "canonicalization_version", "correction_id", "deck_id", "pass_id", "attempt", "host_model_invocation_id", "candidate_manifest_sha256", "validation_report_sha256", "operations", "created_at_utc"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "canonicalization_version": {"const": "p1-rfc8785-nfc-1"},
    "correction_id": {"type": "string", "minLength": 1},
    "deck_id": {"type": "string", "minLength": 1},
    "pass_id": {"type": "string", "minLength": 1},
    "attempt": {"type": "integer", "minimum": 1, "maximum": 2},
    "host_model_invocation_id": {"type": "string", "minLength": 1},
    "candidate_manifest_sha256": {"$ref": "#/$defs/hash"},
    "validation_report_sha256": {"$ref": "#/$defs/hash"},
    "operations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/operation"}},
    "created_at_utc": {"$ref": "#/$defs/timestamp"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "timestamp": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "operation": {
      "type": "object", "additionalProperties": false,
      "required": ["validation_issue_id", "slide_id", "target_type", "target_id", "field", "before", "after"],
      "properties": {
        "validation_issue_id": {"type": "string", "minLength": 1},
        "slide_id": {"type": "string", "minLength": 1},
        "target_type": {"enum": ["spec", "region", "relationship"]},
        "target_id": {"oneOf": [{"type": "string", "minLength": 1}, {"type": "null"}]},
        "field": {"enum": ["bbox", "content_refs", "semantic_source_refs", "parent_region_id", "hierarchy_level", "z_index", "overlap_group", "from_region_id", "to_region_id", "direction", "focal_region_id"]},
        "before": {},
        "after": {}
      }
    }
  }
}
