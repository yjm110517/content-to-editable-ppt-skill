{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "icon-resolution.schema.json",
  "title": "P3.1 Immutable Icon Resolution Record",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_type", "visual_ref", "p2_manifest_sha256", "resolution_method", "source_sha256", "selection_method", "created_at_utc"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "artifact_type": {"const": "icon_resolution_record"},
    "visual_ref": {"type": "string", "minLength": 1},
    "p2_manifest_sha256": {"$ref": "#/$defs/hash"},
    "resolution_method": {"enum": ["tabler_existing", "tabler_composition", "programmatic_svg"]},
    "library": {"const": "tabler-icons"},
    "library_version": {"const": "3.46.0"},
    "icon_name": {"type": "string", "minLength": 1},
    "source_sha256": {"$ref": "#/$defs/hash"},
    "selection_method": {"enum": ["exact_canonical", "exact_official_alias", "host_from_top_k", "bounded_fallback"]},
    "search_evidence_sha256": {"$ref": "#/$defs/hash"},
    "components": {
      "type": "array", "minItems": 2, "maxItems": 2,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["icon_name", "source_sha256"],
        "properties": {"icon_name": {"type": "string", "minLength": 1}, "source_sha256": {"$ref": "#/$defs/hash"}}
      }
    },
    "drawing_spec_sha256": {"$ref": "#/$defs/hash"},
    "created_at_utc": {"type": "string", "format": "date-time", "pattern": "Z$"}
  },
  "allOf": [
    {
      "if": {"properties": {"resolution_method": {"const": "tabler_existing"}}},
      "then": {"required": ["library", "library_version", "icon_name", "search_evidence_sha256"]}
    },
    {
      "if": {"properties": {"resolution_method": {"const": "tabler_composition"}}},
      "then": {"required": ["library", "library_version", "components"], "properties": {"selection_method": {"const": "bounded_fallback"}}}
    },
    {
      "if": {"properties": {"resolution_method": {"const": "programmatic_svg"}}},
      "then": {"required": ["drawing_spec_sha256"], "properties": {"selection_method": {"const": "bounded_fallback"}}}
    }
  ],
  "$defs": {"hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
