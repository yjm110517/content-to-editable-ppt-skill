{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "text-identity-map.schema.json",
  "title": "P0.5 Text Identity Compatibility Map",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "layout_sha256", "authority_sha256", "mappings", "unresolved"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "layout_sha256": {"$ref": "#/$defs/hash"},
    "authority_sha256": {"$ref": "#/$defs/hash"},
    "mappings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["content_ref", "method", "segments"],
        "properties": {
          "content_ref": {"type": "string", "minLength": 1},
          "method": {"enum": ["same_id_and_text", "unique_text", "explicit"]},
          "segments": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["element_id", "segment_order", "joiner"],
              "properties": {
                "element_id": {"type": "string", "minLength": 1},
                "segment_order": {"type": "integer", "minimum": 0},
                "joiner": {"type": "string"}
              }
            }
          }
        }
      }
    },
    "unresolved": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["content_ref", "reason"],
        "properties": {
          "content_ref": {"type": "string", "minLength": 1},
          "reason": {"enum": ["missing", "ambiguous"]},
          "candidate_element_ids": {
            "type": "array",
            "items": {"type": "string", "minLength": 1},
            "uniqueItems": true
          }
        }
      }
    }
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
