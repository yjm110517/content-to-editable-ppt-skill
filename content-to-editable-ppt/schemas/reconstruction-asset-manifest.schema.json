{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "reconstruction-asset-manifest.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "artifact_type", "deck_id", "evidence_root_sha256", "assets", "status"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "artifact_type": {"const": "reconstruction_asset_manifest"},
    "deck_id": {"type": "string", "minLength": 1},
    "evidence_root_sha256": {"$ref": "#/$defs/hash"},
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["asset_ref", "slide_id", "element_id", "record_sha256", "path", "sha256", "media_type", "status"],
        "properties": {
          "asset_ref": {"type": "string", "minLength": 1},
          "slide_id": {"type": "string", "minLength": 1},
          "element_id": {"type": "string", "minLength": 1},
          "record_sha256": {"$ref": "#/$defs/hash"},
          "path": {"type": "string", "minLength": 1},
          "sha256": {"$ref": "#/$defs/hash"},
          "media_type": {"enum": ["image/png", "image/jpeg", "image/svg+xml"]},
          "status": {"const": "approved"}
        }
      }
    },
    "status": {"const": "validated"}
  },
  "$defs": {"hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
