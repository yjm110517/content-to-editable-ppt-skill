{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"reconstruction-compatibility-report.schema.json","type":"object","additionalProperties":false,"required":["schema_version","artifact_type","deck_id","slide_id","element_map_sha256","status","native_shape_count","native_text_count","native_chart_count","sanitized_svg_count","reusable_raster_count","generated_foreground_count","decorative_approximation_count","unclassified_major_visual_count","blocking_issues"],"properties":{"schema_version":{"const":"1.0"},"artifact_type":{"const":"reconstruction_compatibility_report"},"deck_id":{"type":"string","minLength":1},"slide_id":{"type":"string","minLength":1},"element_map_sha256":{"type":"string","pattern":"^[a-f0-9]{64}$"},"status":{"enum":["pass","fail"]},"native_shape_count":{"type":"integer","minimum":0},"native_text_count":{"type":"integer","minimum":0},"native_chart_count":{"type":"integer","minimum":0},"sanitized_svg_count":{"type":"integer","minimum":0},"reusable_raster_count":{"type":"integer","minimum":0},"generated_foreground_count":{"type":"integer","minimum":0},"decorative_approximation_count":{"type":"integer","minimum":0},"unclassified_major_visual_count":{"type":"integer","minimum":0},"blocking_issues":{"type":"array","items":{"type":"object","additionalProperties":false,"required":["code","path","message"],"properties":{"code":{"type":"string","minLength":1},"path":{"type":"string","minLength":1},"message":{"type":"string","minLength":1}}}}}}
