{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "markdown-wireframe-correction-record.schema.json",
  "title": "P2 Markdown Wireframe Correction", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "canonicalization_version", "artifact_type", "correction_id", "deck_id", "attempt", "host_model_invocation_id", "candidate_sha256", "validation_report_sha256", "operations", "created_at_utc"],
  "properties": {
    "schema_version": {"const": "1.0"}, "canonicalization_version": {"const": "p1-rfc8785-nfc-1"},
    "artifact_type": {"const": "markdown_wireframe_correction_record"}, "correction_id": {"type": "string", "minLength": 1},
    "deck_id": {"type": "string", "minLength": 1}, "attempt": {"type": "integer", "minimum": 1, "maximum": 2},
    "host_model_invocation_id": {"type": "string", "minLength": 1}, "candidate_sha256": {"$ref": "#/$defs/hash"},
    "validation_report_sha256": {"$ref": "#/$defs/hash"}, "operations": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/op"}},
    "created_at_utc": {"$ref": "#/$defs/time"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "time": {"type": "string", "format": "date-time", "pattern": "Z$"},
    "op": {"type": "object", "additionalProperties": false, "required": ["op", "validation_issue_id", "path", "before", "after"],
      "properties": {"op": {"enum": ["add", "remove", "replace"]}, "validation_issue_id": {"type": "string", "minLength": 1},
        "path": {"type": "string", "pattern": "^/slides/[0-9]+/(order|layout_draft|layout_notes|content_labels(?:/[0-9]+(?:/(content_ref|label))?)?)$"}, "before": {}, "after": {}}}
  }
}
