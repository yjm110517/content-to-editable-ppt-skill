{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "reconstruction-page-state.schema.json", "type": "object", "additionalProperties": false,
  "required": ["schema_version", "artifact_type", "deck_id", "slide_id", "state", "iteration", "technical_retry_count", "targeted_patch_count", "planner_calls", "reviewer_calls", "current_artifacts", "history"],
  "properties": {
    "schema_version": {"const": "1.0"}, "artifact_type": {"const": "reconstruction_page_state"}, "deck_id": {"type": "string", "minLength": 1}, "slide_id": {"type": "string", "minLength": 1},
    "state": {"enum": ["received", "authority_validated", "seed_ready", "spec_compiled", "spec_validated", "building", "rendering", "deterministic_qa", "fidelity_comparison", "page_reconstructed", "targeted_patch_required", "patching", "failed"]},
    "iteration": {"type": "integer", "minimum": 1, "maximum": 3}, "technical_retry_count": {"type": "integer", "minimum": 0, "maximum": 2}, "targeted_patch_count": {"type": "integer", "minimum": 0, "maximum": 2},
    "planner_calls": {"type": "integer", "minimum": 0, "maximum": 2}, "reviewer_calls": {"type": "integer", "minimum": 0, "maximum": 1}, "current_artifacts": {"type": "object"}, "history": {"type": "array", "items": {"type": "object"}}
  }
}
