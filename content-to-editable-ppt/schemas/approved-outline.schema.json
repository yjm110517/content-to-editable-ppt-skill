{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "approved-outline.schema.json",
  "title": "P1 Approved Outline",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "canonicalization_version", "artifact_id", "deck_id", "revision", "parent_sha256", "candidate_revision", "candidate_sha256", "confirmation_id", "confirmation_sha256", "pages", "approved_at_utc"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "canonicalization_version": {"const": "p1-rfc8785-nfc-1"},
    "artifact_id": {"type": "string", "minLength": 1},
    "deck_id": {"type": "string", "minLength": 1},
    "revision": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "parent_sha256": {"oneOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]},
    "candidate_revision": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "candidate_sha256": {"$ref": "#/$defs/hash"},
    "confirmation_id": {"type": "string", "minLength": 1},
    "confirmation_sha256": {"$ref": "#/$defs/hash"},
    "pages": {"type": "array", "minItems": 1, "items": {"$ref": "candidate-outline.schema.json#/$defs/page"}},
    "approved_at_utc": {"$ref": "#/$defs/timestamp"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "timestamp": {"type": "string", "format": "date-time", "pattern": "Z$"}
  }
}
