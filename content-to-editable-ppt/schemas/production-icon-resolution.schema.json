{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "production-icon-resolution.schema.json",
  "title": "P3.1 Production Icon Resolution Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_type",
    "visual_ref",
    "p2_manifest_sha256",
    "resolution_method",
    "library",
    "library_version",
    "icon_name",
    "source_sha256",
    "selection_method",
    "search_evidence_sha256",
    "created_at_utc"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "artifact_type": {"const": "icon_resolution_record"},
    "visual_ref": {"type": "string", "minLength": 1},
    "p2_manifest_sha256": {"$ref": "#/$defs/hash"},
    "resolution_method": {"const": "tabler_existing"},
    "library": {"const": "tabler-icons"},
    "library_version": {"const": "3.46.0"},
    "icon_name": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "source_sha256": {"$ref": "#/$defs/hash"},
    "selection_method": {
      "enum": ["exact_canonical_name", "exact_official_alias", "host_from_top_k"]
    },
    "search_evidence_sha256": {"$ref": "#/$defs/hash"},
    "selection_decision_sha256": {"$ref": "#/$defs/hash"},
    "created_at_utc": {"type": "string", "format": "date-time", "pattern": "Z$"}
  },
  "allOf": [
    {
      "if": {"properties": {"selection_method": {"const": "host_from_top_k"}}},
      "then": {"required": ["selection_decision_sha256"]},
      "else": {"not": {"required": ["selection_decision_sha256"]}}
    }
  ],
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  }
}
