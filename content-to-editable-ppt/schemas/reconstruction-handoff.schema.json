{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "reconstruction-handoff.schema.json",
  "title": "Deterministic Reconstruction Handoff",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "deck_id", "slide_id", "order", "provenance", "page", "content", "semantic_structure", "structured_data", "stage2"],
  "properties": {
    "schema_version": {"enum": ["1.0", "1.1"]},
    "deck_id": {"$ref": "stage1-authority.schema.json#/$defs/id"},
    "slide_id": {"$ref": "stage1-authority.schema.json#/$defs/id"},
    "order": {"type": "integer", "minimum": 1},
    "provenance": {"$ref": "#/$defs/provenance"},
    "page": {"$ref": "#/$defs/page"},
    "content": {"$ref": "#/$defs/content"},
    "semantic_structure": {"$ref": "#/$defs/semanticProjection"},
    "structured_data": {
      "type": "array",
      "items": {"$ref": "stage1-authority.schema.json#/$defs/structuredData"}
    },
    "stage2": {"$ref": "#/$defs/stage2Projection"}
  },
  "$defs": {
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["stage1_authority_sha256", "stage2_handoff_sha256", "approved_design_sha256", "wireframe_sha256", "visual_spec_sha256"],
      "properties": {
        "stage1_authority_sha256": {"$ref": "#/$defs/sha256"},
        "stage2_handoff_sha256": {"$ref": "#/$defs/sha256"},
        "approved_design_sha256": {"$ref": "#/$defs/sha256"},
        "wireframe_sha256": {"$ref": "#/$defs/sha256"},
        "visual_spec_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "page": {
      "type": "object",
      "additionalProperties": false,
      "required": ["section", "role", "key_message", "source_refs", "visual_need", "wireframe"],
      "properties": {
        "section": {"type": "string"},
        "role": {"type": "string", "minLength": 1},
        "key_message": {"type": "string", "minLength": 1},
        "source_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        },
        "visual_need": {"type": "string", "minLength": 1},
        "wireframe": {"const": "wireframe.md"}
      }
    },
    "content": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text_items"],
      "properties": {
        "text_items": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "stage1-authority.schema.json#/$defs/textItem"}
        }
      }
    },
    "semanticProjection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["objects", "regions", "reading_order", "relations"],
      "properties": {
        "objects": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "stage1-authority.schema.json#/$defs/semanticObject"}
        },
        "regions": {
          "type": "array",
          "items": {"$ref": "stage1-authority.schema.json#/$defs/region"}
        },
        "reading_order": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "stage1-authority.schema.json#/$defs/id"}
        },
        "relations": {
          "type": "array",
          "items": {"$ref": "stage1-authority.schema.json#/$defs/relation"}
        }
      }
    },
    "stage2Projection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approved_design", "visual_spec", "visual_objects"],
      "properties": {
        "approved_design": {"type": "string", "minLength": 1},
        "visual_spec": {"const": "visual-spec.json"},
        "visual_objects": {
          "type": "array",
          "items": {"$ref": "stage2-handoff.schema.json#/$defs/visualObject"}
        }
      }
    }
  }
}
