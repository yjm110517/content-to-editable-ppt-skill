{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "storyboard-anchor-compatibility-record.schema.json",
  "title": "P3.2 Storyboard Anchor Compatibility Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "artifact_type", "deck_id", "slide_id",
    "old_prompt_package_sha256", "new_prompt_package_sha256",
    "slide_prompt_input_sha256", "slide_prompt_sha256",
    "deck_visual_system_sha256", "text_footprint_manifest_sha256",
    "old_anchor_record_sha256", "generated_layer_record_sha256",
    "element_map_sha256", "final_preview_record_sha256",
    "generated_layer_sha256", "final_preview_sha256", "status"
  ],
  "properties": {
    "schema_version": {"const": "1.0"},
    "artifact_type": {"const": "storyboard_anchor_compatibility_record"},
    "deck_id": {"type": "string", "minLength": 1},
    "slide_id": {"type": "string", "minLength": 1},
    "old_prompt_package_sha256": {"$ref": "#/$defs/hash"},
    "new_prompt_package_sha256": {"$ref": "#/$defs/hash"},
    "slide_prompt_input_sha256": {"$ref": "#/$defs/hash"},
    "slide_prompt_sha256": {"$ref": "#/$defs/hash"},
    "deck_visual_system_sha256": {"$ref": "#/$defs/hash"},
    "text_footprint_manifest_sha256": {"$ref": "#/$defs/hash"},
    "old_anchor_record_sha256": {"$ref": "#/$defs/hash"},
    "generated_layer_record_sha256": {"$ref": "#/$defs/hash"},
    "element_map_sha256": {"$ref": "#/$defs/hash"},
    "final_preview_record_sha256": {"$ref": "#/$defs/hash"},
    "generated_layer_sha256": {"$ref": "#/$defs/hash"},
    "final_preview_sha256": {"$ref": "#/$defs/hash"},
    "status": {"const": "compatible"}
  },
  "$defs": {"hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"}}
}
