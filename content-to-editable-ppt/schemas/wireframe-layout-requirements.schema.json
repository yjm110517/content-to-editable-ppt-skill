{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "wireframe-layout-requirements.schema.json",
  "title": "P2 Wireframe Layout Requirements",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "canonicalization_version", "artifact_id", "deck_id", "deck_request_sha256", "revision", "parent_sha256", "density", "preferred_region_structure", "required_visual_zones", "layout_direction", "reserved_areas", "cross_slide_structural_consistency", "layout_constraints_sha256", "source_classifications", "created_at_utc"],
  "properties": {
    "schema_version": {"const": "1.0"},
    "canonicalization_version": {"const": "p1-rfc8785-nfc-1"},
    "artifact_id": {"type": "string", "minLength": 1},
    "deck_id": {"type": "string", "minLength": 1},
    "deck_request_sha256": {"$ref": "#/$defs/hash"},
    "revision": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
    "parent_sha256": {"$ref": "#/$defs/nullable_hash"},
    "density": {"enum": ["compact", "balanced", "spacious", "unspecified"]},
    "preferred_region_structure": {"type": "array", "uniqueItems": true, "items": {"enum": ["single_focus", "split", "modular", "sequential", "comparison"]}},
    "required_visual_zones": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["scope", "role", "minimum_count"],
        "properties": {
          "scope": {"type": "string", "minLength": 1},
          "role": {"enum": ["image", "chart", "diagram"]},
          "minimum_count": {"type": "integer", "minimum": 1, "maximum": 20}
        }
      }
    },
    "layout_direction": {"enum": ["left_to_right", "right_to_left", "top_to_bottom", "radial", "unspecified"]},
    "reserved_areas": {
      "type": "object", "additionalProperties": false,
      "required": ["header_height", "footer_height"],
      "properties": {
        "header_height": {"type": "integer", "minimum": 0, "maximum": 5000},
        "footer_height": {"type": "integer", "minimum": 0, "maximum": 5000}
      }
    },
    "cross_slide_structural_consistency": {"enum": ["strict", "moderate", "flexible", "unspecified"]},
    "layout_constraints_sha256": {"$ref": "#/$defs/hash"},
    "source_classifications": {
      "type": "array",
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["source_index", "classification", "requirement_sha256"],
        "properties": {
          "source_index": {"type": "integer", "minimum": 0},
          "classification": {"enum": ["layout", "p3_only"]},
          "requirement_sha256": {"$ref": "#/$defs/hash"}
        }
      }
    },
    "created_at_utc": {"$ref": "#/$defs/timestamp"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "nullable_hash": {"oneOf": [{"$ref": "#/$defs/hash"}, {"type": "null"}]},
    "timestamp": {"type": "string", "format": "date-time", "pattern": "Z$"}
  }
}
